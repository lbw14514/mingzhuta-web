{
    "0": {
        "34_0": {
            "lines": [
                "这地方究竟怎么了！？"
            ]
        },
        "42_0": {
            "lines": [
                "几周以前来还没这么多破事呢。"
            ]
        },
        "50_0": {
            "lines": [
                "这个店铺怎么一个人也没有……"
            ]
        },
        "152_0": {
            "lines": [
                "那个是店长吗？打扰一下！",
                "能给我来杯咖啡吗？"
            ]
        },
        "160_0": {
            "lines": [
                "……"
            ]
        },
        "168_0": {
            "lines": [
                "这几天一大帮奇人来这里，",
                "怎么还有杀马特闯进来？"
            ]
        },
        "176_0": {
            "lines": [
                "……杀马特？"
            ]
        },
        "184_0": {
            "lines": [
                "不是不是，",
                "我头发颜色不是天生的！"
            ]
        },
        "192_0": {
            "lines": [
                "你的第一印象已经没用了。"
            ]
        },
        "200_0": {
            "lines": [
                "至少我看不出来你像个懂咖啡的，",
                "这可不是你消遣的地方。"
            ]
        },
        "208_0": {
            "lines": [
                "总之，不欢迎光临。"
            ]
        },
        "216_0": {
            "lines": [
                "有病吧？来人付钱",
                "都不理会一下的？"
            ]
        },
        "224_0": {
            "lines": [
                "果然服务业应该懂服务。",
                "看我咋整治你！"
            ]
        },
        "232_0": {
            "lines": [
                "对了，坐在那边要收费的，半小时，",
                "50块钱，不允许续费，到点赶人。"
            ]
        },
        "240_0": {
            "lines": [
                "………………？",
                "怎么把我音乐换了？"
            ]
        },
        "248_0": {
            "lines": [
                "好啊你，居然毁坏我精心设计的",
                "音乐氛围环境！"
            ]
        },
        "256_0": {
            "lines": [
                "虽然我拒绝给你提供服务，",
                "但是你就一点错都没有吗！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "停下停下，",
                "我服了你了。"
            ]
        },
        "42_0": {
            "lines": [
                "虽然我看你就是个混的入，",
                "但是我现在声明你不是杀马特！"
            ]
        },
        "50_0": {
            "lines": [
                "现在行了吧，",
                "你能放过我了吧？"
            ]
        },
        "58_0": {
            "lines": [
                "不是哥们，你眼睛去哪了？",
                "我是露西亚人啊！（掏俄国护照）"
            ]
        },
        "66_0": {
            "lines": [
                "哎呦哎呦我眼拙，",
                "没认出来您！"
            ]
        },
        "74_0": {
            "lines": [
                "这人好奇怪……"
            ]
        },
        "82_0": {
            "lines": [
                "我就是个外地开店的，",
                "你别上平台上挂我哈。"
            ]
        },
        "90_0": {
            "lines": [
                "那个座位您免费坐，",
                "不要钱，一分钱不要。"
            ]
        },
        "98_0": {
            "lines": [
                "然后这个咖啡钱您看着给吧，",
                "放心，您有啥吩咐一声就行！"
            ]
        },
        "106_0": {
            "lines": [
                "你要加奶加糖吗？",
                "加个微信呗以后联系！"
            ]
        },
        "114_0": {
            "lines": [
                "得了吧，你快把我吓死了！",
                "我要准备走人了。"
            ]
        },
        "122_0": {
            "lines": [
                "至于那个歌，我出了门自动换回来，",
                "你不用太担心哈！"
            ]
        },
        "130_0": {
            "lines": [
                "没事没事你这歌真不赖。"
            ]
        },
        "138_0": {
            "lines": [
                "明显就能表现出您品味非常高，",
                "是我眼拙一开始没听清楚……"
            ]
        },
        "146_0": {
            "lines": [
                "你这听着就很牵强了，",
                "好像膝盖都软下来了呢。"
            ]
        },
        "154_0": {
            "lines": [
                "我有那么可怕吗，你第一眼都没看出来。"
            ]
        },
        "162_0": {
            "lines": [
                "不过您来了这里得注意点这个事情，",
                "该花时候得花点，多了没啥不能少了。"
            ]
        },
        "170_0": {
            "lines": [
                "总而言之就是证明您得有消费水平，",
                "表明你能过「精英的生活」。"
            ]
        },
        "178_0": {
            "lines": [
                "要不然的话，",
                "可能会被判定为外来人呢"
            ]
        },
        "186_0": {
            "lines": [
                "而且所谓的外来人，也包括那些",
                "外地回来的本地人的。"
            ]
        },
        "194_0": {
            "lines": [
                "对于那些廉价的饮料和拼好饭，",
                "可以敬而远之了。"
            ]
        },
        "202_0": {
            "lines": [
                "呼——真是惊人的事实",
                "看来我大概知道是怎么回事了。"
            ]
        },
        "210_0": {
            "lines": [
                "真好啊，这下我大概明白这股",
                "不祥的气息从何而来了。"
            ]
        },
        "218_0": {
            "lines": [
                "一杯星巴克，一桶哈根达斯，",
                "就是这里的免死金牌了？"
            ]
        },
        "226_0": {
            "lines": [
                "大概是这样的吧。",
                "您就看着给我们说点好话吧。"
            ]
        },
        "234_0": {
            "lines": [
                "毕竟来这里开个门脸也不容易，",
                "交点朋友实在是老难了。"
            ]
        },
        "242_0": {
            "lines": [
                "那我要一杯25毫升的，",
                "拿玻璃瓶封装起来。"
            ]
        },
        "250_0": {
            "lines": [
                "我知道这很难但我不白拿你的。"
            ]
        },
        "258_0": {
            "lines": [
                "好好好您说啥都成，您拿好了，",
                "这玻璃瓶可是名牌香水的瓶子！"
            ]
        },
        "266_0": {
            "lines": [
                "看在您第一次来，算个玻璃价，",
                "给5块就成，带个好评谢谢！"
            ]
        }
    }
}