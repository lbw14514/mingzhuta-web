{
    "0": {
        "34_0": {
            "lines": [
                "他冯的，怎么我本地人来还要签证啊，",
                "我掏个户口本都不给我过，真服了！"
            ]
        },
        "42_0": {
            "lines": [
                "正好看看这帮乡毋宁开的店吧。"
            ]
        },
        "50_0": {
            "lines": [
                "有钱就是任性哈，这大房子开店。",
                "那就看看这里咖啡怎么样。"
            ]
        },
        "152_0": {
            "lines": [
                "…………"
            ]
        },
        "168_0": {
            "lines": [
                "……"
            ]
        },
        "184_0": {
            "lines": [
                "……"
            ]
        },
        "160_0": {
            "lines": [
                "这家伙搞什么幺蛾子？"
            ]
        },
        "176_0": {
            "lines": [
                "打扰一下——",
                "听到了吗——"
            ]
        },
        "192_0": {
            "lines": [
                "好歹说个欢迎光临吧……"
            ]
        },
        "200_0": {
            "lines": [
                "……不欢迎光临"
            ]
        },
        "208_0": {
            "lines": [
                "我草，吓我一跳"
            ]
        },
        "216_0": {
            "lines": [
                "看阁下这样子，不像懂咖啡的，",
                "甚至看起来好像不那么「上海」呢。"
            ]
        },
        "224_0": {
            "lines": [
                "我总不能去偷上海人偶吧……"
            ]
        },
        "232_0": {
            "lines": [
                "不是我跟通关的自证半天了，",
                "到你这了怎么还得自证啊？"
            ]
        },
        "240_0": {
            "lines": [
                "……"
            ]
        },
        "248_0": {
            "lines": [
                "买个咖啡还这么费劲。"
            ]
        },
        "256_0": {
            "lines": [
                "居然放这种音乐破坏我店里的气氛！"
            ]
        },
        "264_0": {
            "lines": [
                "像你这样一点知识都没有的人，",
                "我不可能卖给你我的招牌咖啡！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "我手里的钱很宝贵啊喂！",
                "你这咖啡是来抢钱的吗？"
            ]
        },
        "42_0": {
            "lines": [
                "那实在是不好意思，",
                "你消费不起就别买啊！"
            ]
        },
        "50_0": {
            "lines": [
                "但是我已经决定了"
            ]
        },
        "58_0": {
            "lines": [
                "我允许你买我的咖啡了。"
            ]
        },
        "66_0": {
            "lines": [
                "那我还真是好奇，",
                "你这咖啡里到底卖的什么冰。"
            ]
        },
        "74_0": {
            "lines": [
                "要冰美式是吧？",
                "那就这样咯。"
            ]
        },
        "82_0": {
            "lines": [
                "我们用的是来自South America",
                "的Robusta咖啡品种。"
            ]
        },
        "90_0": {
            "lines": [
                "采用现代的SiPHon过滤，",
                "并且有ESPResso萃取的风味。"
            ]
        },
        "98_0": {
            "lines": [
                "怎么样？你这种土包子，",
                "怎么可能懂得这些知识？"
            ]
        },
        "106_0": {
            "lines": [
                "哦，罗布斯塔咖啡豆，还行。"
            ]
        },
        "114_0": {
            "lines": [
                "（擦汗）行，这就给你准备，",
                "先把钱付了（有点咬牙切齿）"
            ]
        },
        "122_0": {
            "lines": [
                "一杯基础价格120块，加糖加奶",
                "另算60，总共一百八一杯。"
            ]
        },
        "130_0": {
            "lines": [
                "你牛大了，还好我",
                "还有不少剩余的钱。"
            ]
        },
        "138_0": {
            "lines": [
                "原本在店里停留超过10分钟时间，",
                "我们原则上是要赶人的。"
            ]
        },
        "146_0": {
            "lines": [
                "不是哥们，你这咖啡跟星巴克，",
                "也差不了多少啊？"
            ]
        },
        "154_0": {
            "lines": [
                "而且你是生怕看不出来啊，",
                "还用的是星巴克的杯子？"
            ]
        },
        "162_0": {
            "lines": [
                "……",
                "（屮，好像碰上懂的了……）"
            ]
        },
        "170_0": {
            "lines": [
                "行了行了。糖和奶就算我送你的，",
                "给你退30加个30块的券成不？"
            ]
        },
        "178_0": {
            "lines": [
                "怎么才30啊？"
            ]
        },
        "186_0": {
            "lines": [
                "120块是我自己的，"
            ]
        },
        "194_0": {
            "lines": [
                "你能拿30块钱，",
                "还得看东方明珠塔脸色。"
            ]
        },
        "202_0": {
            "lines": [
                "你在这里想站着把款退了",
                "那我觉得你应该是站不住了。"
            ]
        },
        "210_0": {
            "lines": [
                "你知道的，这就是沪币的购买力。"
            ]
        },
        "218_0": {
            "lines": [
                "还有我必须声明一下，我这里",
                "只接待朋友，不接待上帝。"
            ]
        },
        "226_0": {
            "lines": [
                "你们说「顾客就是上帝」的吧？",
                "那不好意思，那就不接待咯。"
            ]
        }
    }
}