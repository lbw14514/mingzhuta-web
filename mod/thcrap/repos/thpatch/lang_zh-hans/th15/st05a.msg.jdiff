{
    "2": {
        "50_0": {
            "lines": [
                "呀啊啊啊啊！",
                "禁止携带外来食品进入园区！"
            ]
        },
        "180_0": {
            "lines": [
                "保安们啊，速度快一点！"
            ]
        },
        "330_0": {
            "lines": [
                "　　　It's Dixxey Empire!　　　",
                "　　　欢迎来到梦幻的世界！"
            ]
        }
    },
    "0": {
        "34_0": {
            "lines": [
                "都是烟花之类的东西，真有意思。"
            ]
        },
        "42_0": {
            "lines": [
                "远处的东方明珠塔变得奇怪起来了呢。",
                "怎么好像塔顶放出了红光？"
            ]
        },
        "50_0": {
            "lines": [
                "而且路过这么多店铺都躁动起来了……"
            ]
        },
        "58_0": {
            "lines": [
                "说起来，蜜雪冰城还真是到处都有呢"
            ]
        },
        "156_0": {
            "lines": [
                "这样说可不对。"
            ]
        },
        "164_0": {
            "lines": [
                "本来，你是没有资格喝那种饮料的。",
                "喝了会有严重的后果。"
            ]
        },
        "172_0": {
            "lines": [
                "啊，刚才那家伙",
                "看你的样子好像也是个STAFF"
            ]
        },
        "180_0": {
            "lines": [
                "嗯，我是妙妙屋的主人：",
                "克劳恩米奇！"
            ]
        },
        "188_0": {
            "lines": [
                "现在我的兄弟们还不在我身边，",
                "但是你愿意来看看我的妙妙屋吗？"
            ]
        },
        "196_0": {
            "lines": [
                "原来来到了迪〇尼吗？",
                "我还真是胡乱跑呢。"
            ]
        },
        "204_0": {
            "lines": [
                "迪〇尼啦，就是最著名的乐园啊。",
                "我们完全会保证你的安全。"
            ]
        },
        "212_0": {
            "lines": [
                "保证安全，那我可以放心玩了。",
                "票也买了让我进去呗。"
            ]
        },
        "220_0": {
            "lines": [
                "啊，对了，第一步需要安检一下。",
                "我们需要打开你的包检查所有的食物。"
            ]
        },
        "228_0": {
            "lines": [
                "要是有外带食物的话，",
                "不必手下留情的说。"
            ]
        },
        "236_0": {
            "lines": [
                "区区娱乐场所而已",
                "你以为你是谁啊"
            ]
        },
        "244_0": {
            "lines": [
                "你？不认识，那咋了？"
            ]
        },
        "252_0": {
            "lines": [
                "我这食物可是要让我吃到返程的。",
                "难道这都不体谅一下的吗！"
            ]
        },
        "260_0": {
            "lines": [
                "哎？意外收获啊！",
                "居然有蜜雪冰城的柠檬水？"
            ]
        },
        "268_0": {
            "lines": [
                "既然如此，",
                "你现在就是全沪的高危人士了呢！"
            ]
        },
        "276_0": {
            "lines": [
                "我想到一个好主意啦",
                "是时候先于东方明珠塔一步开战了！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "哈…哈…哈…"
            ]
        },
        "42_0": {
            "lines": [
                "你瞅你那样！",
                "你和另一个鼠是苦命鸳鸯吗？"
            ]
        },
        "50_0": {
            "lines": [
                "何，何意味……？"
            ]
        },
        "58_0": {
            "lines": [
                "不可能，浮华生活的力量还存在，",
                "它现在还支配着这里！"
            ]
        },
        "66_0": {
            "lines": [
                "而且就算你赢了我，面对它",
                "也是束手无策啊！"
            ]
        },
        "74_0": {
            "lines": [
                "说来刚才没收我的那些食物，"
            ]
        },
        "82_0": {
            "lines": [
                "现在你必须还给我了吧？",
                "不然的话……"
            ]
        },
        "90_0": {
            "lines": [
                "你这家伙……",
                "连法务部都奈何不了你了吗？"
            ]
        },
        "98_0": {
            "lines": [
                "你没听到我刚才说的话吗？"
            ]
        },
        "106_0": {
            "lines": [
                "让我把食物带进去！",
                "尼尔多隆吗？！"
            ]
        },
        "114_0": {
            "lines": [
                "再无话说，这就还给你。"
            ]
        },
        "122_0": {
            "lines": [
                "那么，你这个家伙是来干嘛的？"
            ]
        },
        "130_0": {
            "lines": [
                "唔，我本来"
            ]
        },
        "138_0": {
            "lines": [
                "是想来这里好好旅游度假的，",
                "要真正的来一场旅游。"
            ]
        },
        "146_0": {
            "lines": [
                "不知不觉就发展成要去战斗爽了。"
            ]
        },
        "154_0": {
            "lines": [
                "终于还是要对东方明珠塔发起冲锋了？",
                "真是可惜，你永远不会赢的。"
            ]
        },
        "162_0": {
            "lines": [
                "除非你的家乡有足够强大的防御塔，",
                "否则有你好受的！"
            ]
        },
        "170_0": {
            "lines": [
                "……可惜我只能代纯狐喊一句：",
                "嫦娥啊，你看到了吗？"
            ]
        },
        "178_0": {
            "lines": [
                "说起来我要准备离开这里了，",
                "最后去坐下轮渡吧。"
            ]
        },
        "186_0": {
            "lines": [
                "你说的东方明珠塔，",
                "我应该没机会去和它战斗了吧。"
            ]
        }
    }
}