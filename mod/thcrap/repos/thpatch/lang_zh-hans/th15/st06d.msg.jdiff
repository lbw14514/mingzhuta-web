{
    "0": {
        "214_0": {
            "lines": [
                "不管如何阻挡你们",
                "却总有办法成功破解"
            ]
        },
        "222_0": {
            "lines": [
                "这种样子的外乡人",
                "之前完全没有见过呢"
            ]
        },
        "260_0": {
            "lines": [
                "……谁？"
            ]
        },
        "268_0": {
            "lines": [
                "就是你故意把我引出来的吧。"
            ]
        },
        "276_0": {
            "lines": [
                "我只是恨透了那些穷酸的家伙罢了。"
            ]
        },
        "284_0": {
            "lines": [
                "可惜你没有办法动我，",
                "因为我可是外邦人！"
            ]
        },
        "292_0": {
            "lines": [
                "没想到竟然会把外国人送到海上来，",
                "外乡人你们赢了。"
            ]
        },
        "300_0": {
            "lines": [
                "铁了心要挑战我的权威吗？"
            ]
        },
        "308_0": {
            "lines": [
                "那当然，人为界定高低级消费什么的，",
                "我就是想喝一杯柠檬水呢？"
            ]
        },
        "316_0": {
            "lines": [
                "我可以说清楚！"
            ]
        },
        "324_0": {
            "lines": [
                "我只是带得钱少！既然能支撑我留学，",
                "我未必不能过什么精致的生活！"
            ]
        },
        "332_0": {
            "lines": [
                "不尊重大家选择的分明是你才对吧？",
                "何况柠檬水原来已经成低端货了吗？"
            ]
        },
        "340_0": {
            "lines": [
                "为了喝口廉价饮料，",
                "就要挑战这精致生活区吗？"
            ]
        },
        "348_0": {
            "lines": [
                "想做这些，可以去别处做。"
            ]
        },
        "356_0": {
            "lines": [
                "没那么容易。"
            ]
        },
        "364_0": {
            "lines": [
                "今天来挑战你，",
                "姑且是讨回柠檬水的公道。"
            ]
        },
        "372_0": {
            "lines": [
                "还有一点更重要的东西"
            ]
        },
        "380_0": {
            "lines": [
                "把这种没有用的溢价消灭干净！"
            ]
        },
        "388_0": {
            "lines": [
                "有趣……只要你们外邦人不介意的话",
                "就尽管放马过来吧"
            ]
        },
        "396_0": {
            "lines": [
                "即使你历经千难万险来到这里，",
                "我的眼中也容不下这些痕迹。"
            ]
        },
        "404_0": {
            "lines": [
                "即使和廉价饮料已经不共戴天，",
                "只有这份精致会继续纯化外乡人。"
            ]
        },
        "412_0": {
            "lines": [
                "见识一下吧！",
                "我这份点到100%的净化机制！"
            ]
        }
    },
    "1": {
        "214_0": {
            "lines": [
                "不管如何阻挡你们",
                "却总有办法成功破解"
            ]
        },
        "222_0": {
            "lines": [
                "这种样子的外乡人",
                "之前完全没有见过呢"
            ]
        },
        "260_0": {
            "lines": [
                "……谁？"
            ]
        },
        "268_0": {
            "lines": [
                "就是你故意把我引出来的吧。"
            ]
        },
        "276_0": {
            "lines": [
                "我只是恨透了那些穷酸的家伙罢了。"
            ]
        },
        "284_0": {
            "lines": [
                "可惜你没有办法动我，",
                "因为我可是外邦人！"
            ]
        },
        "292_0": {
            "lines": [
                "没想到竟然会把外国人送到海上来，",
                "外乡人你们赢了。"
            ]
        },
        "300_0": {
            "lines": [
                "可你又是怎么回事？",
                "为什么你会如此的穷酸？"
            ]
        },
        "308_0": {
            "lines": [
                "为什么你被他们一次次击落",
                "而坠机了呢，你是牢大吗？"
            ]
        },
        "316_0": {
            "lines": [
                "废话，被你们这里那些没价值的",
                "高溢价产品算计了3036次，"
            ]
        },
        "324_0": {
            "lines": [
                "虽然你说我是牢大，但我挺过来了，",
                "我能留条命来见你，牢大做得到吗！"
            ]
        },
        "332_0": {
            "lines": [
                "为了喝口廉价饮料，",
                "就要挑战这精致生活区吗？"
            ]
        },
        "340_0": {
            "lines": [
                "把廉价饮料店开到崇明岛，",
                "再拿外邦人作掩护来攻击我"
            ]
        },
        "348_0": {
            "lines": [
                "你们的计划实在是高明啊！"
            ]
        },
        "356_0": {
            "lines": [
                "诶，啊，这样啊？"
            ]
        },
        "364_0": {
            "lines": [
                "但是奇策归奇策",
                "外乡人还是犯下了愚蠢的失误"
            ]
        },
        "372_0": {
            "lines": [
                "像你这种被穷酸的气息包围的人",
                "哪怕来自外邦，怎么可能将我打倒"
            ]
        },
        "380_0": {
            "lines": [
                "以我的激光之力可以无条件地",
                "毁掉你的签证，将你赶出去。"
            ]
        },
        "388_0": {
            "lines": [
                "即使和廉价饮料已经不共戴天，",
                "只有这份精致会继续纯化外邦人。"
            ]
        },
        "396_0": {
            "lines": [
                "不共戴天之敌，雪王啊。你在看着吗！？",
                "此人带来的这些穷酸！这些老土！"
            ]
        }
    }
