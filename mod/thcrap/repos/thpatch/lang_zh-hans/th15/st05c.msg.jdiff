{
    "2": {
        "50_0": {
            "lines": [
                "呀啊啊啊啊！",
                "禁止携带外来食品进入园区！"
            ]
        },
        "180_0": {
            "lines": [
                "保安们啊，速度快一点！"
            ]
        },
        "330_0": {
            "lines": [
                "　　　It's Dixxey Empire!　　　",
                "　　　欢迎来到梦幻的世界！"
            ]
        }
    },
    "0": {
        "34_0": {
            "lines": [
                "终于买到苹果17PROMAX了，",
                "老手机都快没我高考计算器快了！"
            ]
        },
        "42_0": {
            "lines": [
                "何况毕竟同学都人手一部了，",
                "不对，怎么他们都换成苹果了？"
            ]
        },
        "50_0": {
            "lines": [
                "算了，还有点闲钱去玩玩吧。",
                "就这样回家简直对不起我打的工。"
            ]
        },
        "58_0": {
            "lines": [
                "我才刚出去了三个月吧？"
            ]
        },
        "66_0": {
            "lines": [
                "现在的上海怎么变成了",
                "我根本不认识的样子了？"
            ]
        },
        "164_0": {
            "lines": [
                "竟然能从那么多保安",
                "手里的棍子中穿过来"
            ]
        },
        "172_0": {
            "lines": [
                "有两下子嘛"
            ]
        },
        "180_0": {
            "lines": [
                "我只不过是来玩玩，",
                "也要被分个三六九等了吗？"
            ]
        },
        "188_0": {
            "lines": [
                "呵呵，我早就知道你。"
            ]
        },
        "196_0": {
            "lines": [
                "你是威震上海滩的热门短剧演员，",
                "还是一个真正的上海本地人。"
            ]
        },
        "204_0": {
            "lines": [
                "但是不幸的，评判你在魔都地位的，",
                "不是户籍或居住证，而是经济实力。"
            ]
        },
        "212_0": {
            "lines": [
                "或者说，应该是你个人的经济实力。",
                "否则，你都未必有排队买的资格。"
            ]
        },
        "220_0": {
            "lines": [
                "啊，买了一个手机，",
                "还有一杯柠檬茶，确实没剩多少。"
            ]
        },
        "228_0": {
            "lines": [
                "你手里的柠檬茶，可是不允许的呢。"
            ]
        },
        "236_0": {
            "lines": [
                "先不说这本就不应该出现在魔都，",
                "外带食物进入园区本就不被允许！"
            ]
        },
        "244_0": {
            "lines": [
                "你就是想吃拼好饭，",
                "也得去点园区里的饭店！"
            ]
        },
        "252_0": {
            "lines": [
                "也没有多么贵，毕竟是拼好饭。",
                "仅需400沪币！优惠吧？"
            ]
        },
        "260_0": {
            "lines": [
                "你觉得优惠与否也已经没有用了，",
                "接下来该按照管理条例驱逐你了！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "哈…哈…哈…"
            ]
        },
        "42_0": {
            "lines": [
                "为，为什么……？"
            ]
        },
        "50_0": {
            "lines": [
                "你这样的实力，",
                "居然敢于漠视这样的秩序？"
            ]
        },
        "58_0": {
            "lines": [
                "不可能啊，东方明珠塔看到这些，",
                "怎么可能袖手旁观呢？"
            ]
        },
        "66_0": {
            "lines": [
                "哈？我都没说你乡毋宁（外地人）。"
            ]
        },
        "74_0": {
            "lines": [
                "你这家伙……不，阁下",
                "难道真是上海人！？"
            ]
        },
        "82_0": {
            "lines": [
                "跟我打了一架你看来是失忆了。",
                "你不是都听说过我的大名了吗？"
            ]
        },
        "90_0": {
            "lines": [
                "但是我也和你说过的吧，",
                "你喝下去的柠檬水就是最大的威胁。"
            ]
        },
        "98_0": {
            "lines": [
                "我可是在这里生活了十八年的人，",
                "这里的每一寸土地我都一清二楚。"
            ]
        },
        "106_0": {
            "lines": [
                "可是我才不过离开了三个月，"
            ]
        },
        "114_0": {
            "lines": [
                "就「笑」问客从何处来了？"
            ]
        },
        "122_0": {
            "lines": [
                "为什么突然就变成了这种样子了呢？"
            ]
        },
        "130_0": {
            "lines": [
                "嗯——",
                "不知道你在说些什么"
            ]
        },
        "138_0": {
            "lines": [
                "你不知道就不知道吧，",
                "但是我都明白了。"
            ]
        },
        "146_0": {
            "lines": [
                "你们变成了我不认识的样子，",
                "东方明珠塔也是的吧……"
            ]
        },
        "154_0": {
            "lines": [
                "也罢，为了捍卫我买蜜雪冰城的自由，"
            ]
        },
        "162_0": {
            "lines": [
                "以及报复那并不好喝的咖啡店，战斗吧。"
            ]
        },
        "170_0": {
            "lines": [
                "你穿成这样，我还以为你是Staff。"
            ]
        },
        "178_0": {
            "lines": [
                "才不是「士大夫」，",
                "我可是扮演天子的！"
            ]
        },
        "186_0": {
            "lines": [
                "估计是为了赶火车吧，",
                "衣服都没有顾得脱下来。"
            ]
        },
        "194_0": {
            "lines": [
                "你这家伙，可好好地",
                "在上海滩火了一把。"
            ]
        },
        "202_0": {
            "lines": [
                "从浦西到崇明岛，",
                "没有人不知道你这个行为艺术家。"
            ]
        },
        "210_0": {
            "lines": [
                "我也要「感谢」你啊，感谢你",
                "把我来这里玩一趟的兴致都打没了。"
            ]
        },
        "218_0": {
            "lines": [
                "连买什么吃什么都有限制啊！",
                "这对吗！"
            ]
        },
        "226_0": {
            "lines": [
                "我也是按规矩办事啊，",
                "你有啥事，跟签证说去呗……"
            ]
        }
    }
}