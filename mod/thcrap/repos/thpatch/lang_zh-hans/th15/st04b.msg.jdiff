{
    "0": {
        "34_0": {
            "lines": [
                "这里是……咖啡店啊？"
            ]
        },
        "42_0": {
            "lines": [
                "为什么放眼望去几乎看不到",
                "一个活物啊"
            ]
        },
        "50_0": {
            "lines": [
                "就只有刚才碰到的那家伙而已"
            ]
        },
        "58_0": {
            "lines": [
                "我来上海了吗，怎么进个店死气沉沉的？",
                "这样的店还在开，有啥意义吗？"
            ]
        },
        "160_0": {
            "lines": [
                "…………"
            ]
        },
        "168_0": {
            "lines": [
                "说曹操曹操到"
            ]
        },
        "176_0": {
            "lines": [
                "……嚯，乡巴佬？"
            ]
        },
        "184_0": {
            "lines": [
                "不欢迎光临。"
            ]
        },
        "192_0": {
            "lines": [
                "那就是欢迎咯？"
            ]
        },
        "200_0": {
            "lines": [
                "来都来了那就整点啥吧，",
                "你们这里卖咖啡的吧？"
            ]
        },
        "208_0": {
            "lines": [
                "你想要枫丹白露萃取还是堂吉诃德萃取？"
            ]
        },
        "216_0": {
            "lines": [
                "？啥是萃取，不清楚，",
                "您看着调呗，我没啥忌口。"
            ]
        },
        "224_0": {
            "lines": [
                "你家这菜单上还有中国字吗？",
                "虽然我也不是看不懂英文。"
            ]
        },
        "232_0": {
            "lines": [
                "哦，不好意思，我们拒绝服务。"
            ]
        },
        "240_0": {
            "lines": [
                "但是你这取的名字，",
                "牛头不对马嘴的，心累。"
            ]
        },
        "248_0": {
            "lines": [
                "你看上去倒是知道得很多的样子嘛",
                "送上门的钱你都不赚了啊？"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "既然你这个外行人执意插手进来，",
                "那我们也没办法拿你当朋友。"
            ]
        },
        "42_0": {
            "lines": [
                "毕竟主理人可不是给顾客当上帝的。"
            ]
        },
        "50_0": {
            "lines": [
                "你们的那些大众审美，",
                "说白了都是低级趣味。"
            ]
        },
        "58_0": {
            "lines": [
                "你这话我倒是无法反驳。"
            ]
        },
        "66_0": {
            "lines": [
                "可是你这爱答不理的样子，",
                "我都怀疑你是不是快破产了。"
            ]
        },
        "74_0": {
            "lines": [
                "关你什么事？"
            ]
        },
        "82_0": {
            "lines": [
                "我们只为真正的顾客服务，你们这些人，",
                "甚至没有权利随意使用我们的厕所。"
            ]
        },
        "90_0": {
            "lines": [
                "我这辈子没见过这种的。"
            ]
        },
        "98_0": {
            "lines": [
                "现在你见到了就知足吧，",
                "还没有制定好逐客令你很幸运了。"
            ]
        },
        "106_0": {
            "lines": [
                "不过作为你刚才活下来的奖励，",
                "我决定给你一杯咖啡。"
            ]
        },
        "114_0": {
            "lines": [
                "哎，你们可真是扫兴。"
            ]
        },
        "122_0": {
            "lines": [
                "你说的话完全听不懂啊"
            ]
        },
        "130_0": {
            "lines": [
                "我已经失去对你的兴趣了，",
                "你未免太挑剔了。"
            ]
        },
        "138_0": {
            "lines": [
                "让我们这帮醉心于爱好的人",
                "给你来服务，"
            ]
        },
        "146_0": {
            "lines": [
                "那我不加点钱还说不过去呢，",
                "这次先放过你。"
            ]
        },
        "154_0": {
            "lines": [
                "服务业不该懂点服务吗？"
            ]
        },
        "162_0": {
            "lines": [
                "啊是没错"
            ]
        },
        "170_0": {
            "lines": [
                "但是，不好意思，",
                "我们只给朋友服务。"
            ]
        },
        "178_0": {
            "lines": [
                "对于你们这些不懂咖啡的人，",
                "给你调一杯出来已经是莫大的恩赐了。"
            ]
        },
        "186_0": {
            "lines": [
                "所以我看，你也不要不知好歹，",
                "不要再放你那破歌了，南町的相思。"
            ]
        },
        "194_0": {
            "lines": [
                "行吧，我尝尝啊……"
            ]
        },
        "202_0": {
            "lines": [
                "没啥特点，像从隔壁瑞幸拿过来的。",
                "这就是你说的独家技术？"
            ]
        },
        "210_0": {
            "lines": [
                "虽然我确实用了点瑞幸的成品吧。"
            ]
        },
        "218_0": {
            "lines": [
                "但是指出它有问题的你，",
                "难道就一点错都没有吗？"
            ]
        },
        "226_0": {
            "lines": [
                "更何况我这根本算不上问题。"
            ]
        },
        "234_0": {
            "lines": [
                "你觉得它有问题，",
                "分明是你的味蕾有问题。"
            ]
        },
        "242_0": {
            "lines": [
                "你不懂咖啡这一块，",
                "乡巴佬！"
            ]
        }
    }
}