{
    "0": {
        "34_0": {
            "lines": [
                "果然南方这地方还是暖和，",
                "这湖是真不赖啊。"
            ]
        },
        "102_0": {
            "lines": [
                "对背叛者的绞杀啊，",
                "乃是无穷无尽的使命……"
            ]
        },
        "144_0": {
            "lines": [
                "但本是同根生，相煎何太急啊？"
            ]
        },
        "152_0": {
            "lines": [
                "你谁啊？",
                "上来就说听不懂的话？"
            ]
        },
        "160_0": {
            "lines": [
                "这蒙蒙胧的雾雨天，",
                "正好是我活动的时节。"
            ]
        },
        "168_0": {
            "lines": [
                "若是我在雨中舞动起来，",
                "该有多少人加我微信呢？"
            ]
        },
        "176_0": {
            "lines": [
                "加你微信倒是在想桃子。",
                "但是你确实打扰到我看风景了。"
            ]
        },
        "184_0": {
            "lines": [
                "当然，我没那么小心眼，",
                "我可不会跟嘉豪计较。"
            ]
        },
        "192_0": {
            "lines": [
                "我会用实际行动证明，",
                "你侮辱我是要付出代价的！"
            ]
        },
        "200_0": {
            "lines": [
                "先给你出一道题好了，",
                "78+13=？"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "你是在嘲讽我不懂计算吗？",
                "你这东西明显就是个小儿科。"
            ]
        },
        "42_0": {
            "lines": [
                "不就是等于91吗？"
            ]
        },
        "50_0": {
            "lines": [
                "哈哈哈，细节细节，还有暗广！"
            ]
        },
        "58_0": {
            "lines": [
                "你居然连这种细节都发现不了啊！"
            ]
        },
        "66_0": {
            "lines": [
                "你有病是真的，",
                "而且病得不轻。"
            ]
        },
        "74_0": {
            "lines": [
                "NO NO NO！"
            ]
        },
        "82_0": {
            "lines": [
                "黑客的低调，",
                "可不是你能想象到的。"
            ]
        },
        "90_0": {
            "lines": [
                "在你即将踏上名为命运的列车之前，",
                "你就已经似掉了！"
            ]
        },
        "98_0": {
            "lines": [
                "是吗……"
            ]
        }
    }
}