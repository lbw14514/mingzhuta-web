{
    "0": {
        "34_0": {
            "lines": [
                "上海是如此近……"
            ]
        },
        "102_0": {
            "lines": [
                "我说是谁啊"
            ]
        },
        "140_0": {
            "lines": [
                "这不是北方来的安卓人嘛"
            ]
        },
        "148_0": {
            "lines": [
                "看来只是一尊雕像而已啊",
                "……等等"
            ]
        },
        "156_0": {
            "lines": [
                "真身！？",
                "难道是真身！？"
            ]
        },
        "164_0": {
            "lines": [
                "你这我就不太满意了，",
                "你为啥连人和戏服都分不清楚？"
            ]
        },
        "172_0": {
            "lines": [
                "你这人穿个戏服过来诈骗我来了，",
                "我跟你说，我可不吃你这一套。"
            ]
        },
        "180_0": {
            "lines": [
                "你什么手机，什么学历，几线城市！"
            ]
        },
        "188_0": {
            "lines": [
                "我去，遇到暴发「户」了。",
                "我这一路上遇到太多激光了。"
            ]
        },
        "196_0": {
            "lines": [
                "魔都……就是这样子啊！",
                "驱逐所有吃喝廉价东西之人！"
            ]
        },
        "204_0": {
            "lines": [
                "何况我可是费了大力气才来这里的，",
                "怎么能让你这身无分文的人进这里！"
            ]
        },
        "212_0": {
            "lines": [
                "现在，睡吧",
                "醒来时你就要回去工作了！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "你知道的，为了拿到沪签，",
                "我可是疯狂消费奢侈品啊！"
            ]
        },
        "42_0": {
            "lines": [
                "那种生活是不能和安卓人相提并论的，",
                "任何安卓人的僭越都是莫大的侮辱！"
            ]
        },
        "50_0": {
            "lines": [
                "这有什么，现在我还活着呢。"
            ]
        },
        "58_0": {
            "lines": [
                "很好，你手里有光明牛奶。"
            ]
        },
        "66_0": {
            "lines": [
                "看来它算是当了你的护身符呢。",
                "但是你要记住："
            ]
        },
        "74_0": {
            "lines": [
                "享受享受沪币的低购买力就够了，",
                "不要试图喝什么廉价的饮品。"
            ]
        },
        "82_0": {
            "lines": [
                "那，可以被称之为",
                "疯狂的防御系统，"
            ]
        },
        "90_0": {
            "lines": [
                "平等的注视着每一个外来者。",
                "请做好充足的心理准备。"
            ]
        },
        "98_0": {
            "lines": [
                "……我不太明白"
            ]
        },
        "106_0": {
            "lines": [
                "普天之下，还有花钱都去不得的地方？",
                "北京地铁我都随便坐（就是要付钱）。"
            ]
        }
    }
}