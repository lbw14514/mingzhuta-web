{
    "0": {
        "214_0": {
            "lines": [
                "不管如何阻挡你们",
                "却总有办法成功破解"
            ]
        },
        "222_0": {
            "lines": [
                "真不甘心",
                "明明差一点点就能把你们阻挡在外了呢"
            ]
        },
        "260_0": {
            "lines": [
                "原来塔真的会说话的吗！",
                "变成了毁灭一切的魔丸啊！"
            ]
        },
        "268_0": {
            "lines": [
                "……真没想到你把穷酸气都打没了。"
            ]
        },
        "276_0": {
            "lines": [
                "居然这么快就融入上海生活了啊。"
            ]
        },
        "284_0": {
            "lines": [
                "你在搞笑吗？我就是上海宁啊！"
            ]
        },
        "292_0": {
            "lines": [
                "没想到竟然会把外乡人送到上海来",
                "外乡人你们真是赢了！"
            ]
        },
        "300_0": {
            "lines": [
                "我的设想还是太天真了",
                "谁胜谁负早已明了……"
            ]
        },
        "308_0": {
            "lines": [
                "不是你能不能听我说两句？"
            ]
        },
        "316_0": {
            "lines": [
                "我就是上海本地土生土长高考的，",
                "户籍也有，我就是打了工回来而已！"
            ]
        },
        "324_0": {
            "lines": [
                "既然是上海人，就不需要外出打工。"
            ]
        },
        "332_0": {
            "lines": [
                "追求精致生活的人分明能够好好定居在此。"
            ]
        },
        "340_0": {
            "lines": [
                "在我的标准下，你明显不够格啊！"
            ]
        },
        "348_0": {
            "lines": [
                "怎么回事，这份无处宣泄的愤怒"
            ]
        },
        "356_0": {
            "lines": [
                "我明明回来了，融入了，却被排斥，",
                "这到底是怎么一回事？"
            ]
        },
        "364_0": {
            "lines": [
                "明明要驱逐掉所有拉低生活情调的人，",
                "看来我输了呢，收不回你的签证。"
            ]
        },
        "372_0": {
            "lines": [
                "收回签证又怎么样，我在这里有家！"
            ]
        },
        "380_0": {
            "lines": [
                "不，我不过是平等地驱逐每个破坏者而已。"
            ]
        },
        "388_0": {
            "lines": [
                "没法证明能支撑住精致生活方式的人，",
                "是没有任何资格留在这里的。"
            ]
        },
        "396_0": {
            "lines": [
                "我买了苹果手机，咖啡，还有柠檬水。"
            ]
        },
        "404_0": {
            "lines": [
                "柠檬水……吗？"
            ]
        },
        "412_0": {
            "lines": [
                "那看起来你那些所谓的高消费，",
                "只是装给我看来打掩护的吧？"
            ]
        },
        "420_0": {
            "lines": [
                "没有用的！你这拙劣的演技，",
                "我可是都看在眼里啊！"
            ]
        },
        "428_0": {
            "lines": [
                "即使和廉价饮料已经不共戴天，",
                "只有这份精致会继续纯化外乡人。"
            ]
        },
        "436_0": {
            "lines": [
                "你也见识一下吧！",
                "赌上性命的假本地人的挣扎！"
            ]
        },
        "444_0": {
            "lines": [
                "你不是打败了阻挡你的每一个人吗？",
                "是时候让你见识一下不一样的上海滩了！"
            ]
        }
    },
    "1": {
        "214_0": {
            "lines": [
                "不管如何拟定计划",
                "却总有办法成功破解"
            ]
        },
        "222_0": {
            "lines": [
                "但是，就这么想混入上海的生活，",
                "还是以失败收场呢。"
            ]
        },
        "260_0": {
            "lines": [
                "你就是他们口中说的上海明珠塔吗？",
                "作为电视塔或是酒店，你不会说话的！"
            ]
        },
        "268_0": {
            "lines": [
                "是吗，原来你还以为可以挑战我",
                "这种想法真是贻笑大方"
            ]
        },
        "276_0": {
            "lines": [
                "让一个外乡人混进来，",
                "却还要装自己是本地人？"
            ]
        },
        "284_0": {
            "lines": [
                "虽然是个大胆的计划",
                "看来还是功亏一篑呢"
            ]
        },
        "292_0": {
            "lines": [
                "你有病吧，我怎么被开除上海籍了？"
            ]
        },
        "300_0": {
            "lines": [
                "像你这种被穷酸的气息包围的",
                "外地人怎么可能将我打倒？"
            ]
        },
        "308_0": {
            "lines": [
                "你总是说你是土生土长的，"
            ]
        },
        "316_0": {
            "lines": [
                "可问题在于，你那可怜的消费能力，",
                "真是让人完全看不出来一点。"
            ]
        },
        "324_0": {
            "lines": [
                "你连他们那样的激光都躲不过，",
                "结果却来挑战我，不自量力。"
            ]
        },
        "332_0": {
            "lines": [
                "不是买个新款苹果手机就行吗？"
            ]
        },
        "340_0": {
            "lines": [
                "虽然说买了也不剩多少钱了……"
            ]
        },
        "348_0": {
            "lines": [
                "真是拙劣的附庸风雅啊！"
            ]
        },
        "356_0": {
            "lines": [
                "我又不是一分钱没有还活不下去了，",
                "你好好看看，我还是有钱买柠檬水的！"
            ]
        },
        "364_0": {
            "lines": [
                "竟然犯下如此愚蠢的失误！"
            ]
        },
        "372_0": {
            "lines": [
                "谁告诉你是上海人就一定是上海人了？",
                "你都没办法承担这种精致的生活方式！"
            ]
        },
        "380_0": {
            "lines": [
                "即使和廉价饮料已经不共戴天，",
                "只有这份精致会继续纯化外乡人。"
            ]
        },
        "388_0": {
            "lines": [
                "不共戴天之敌，雪王啊。你在看着吗！？",
                "此人在魔都的间隙之中挣扎的样子！"
            ]
        }
    }
}