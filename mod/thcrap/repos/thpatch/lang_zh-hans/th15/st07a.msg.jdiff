{
    "2": {
        "184_0": {
            "lines": [
                "居然准备踏上返程之旅了吗？"
            ]
        },
        "308_0": {
            "lines": [
                "今天我以沪×风的名号，"
            ]
        },
        "432_0": {
            "lines": [
                "把你对精英生活方式的亵渎，",
                "全都发泄到你的身上吧！"
            ]
        }
    },
    "0": {
        "214_0": {
            "lines": [
                "为了在魔都喝上一杯柠檬水，",
                "你还真的是煞费苦心啊。"
            ]
        },
        "222_0": {
            "lines": [
                "愚蠢的外乡人都已经派人来搅局了，",
                "要是再这样下去就真的要失败了。"
            ]
        },
        "260_0": {
            "lines": [
                "好啊我就知道又是你！"
            ]
        },
        "268_0": {
            "lines": [
                "现在你要干什么？把我爆头吗？"
            ]
        },
        "276_0": {
            "lines": [
                "没有了入沪签证的限制，"
            ]
        },
        "284_0": {
            "lines": [
                "这些外乡人居然已经能自由地进出这里了。",
                "在这片土地上开起了一家家廉价食品店。"
            ]
        },
        "292_0": {
            "lines": [
                "当然，在我的影响下还不会有人光顾他们。"
            ]
        },
        "300_0": {
            "lines": [
                "为了让这种精致感高级感不被扼杀，",
                "我特地从西洋请来一个神仙"
            ]
        },
        "308_0": {
            "lines": [
                "好了快出来吧！",
                "星巴克的女神，雷碧百事祖利啊！"
            ]
        },
        "420_0": {
            "lines": [
                "都已经连星巴克都喝不起了吗？",
                "这样可是不能进入魔都俱乐部的。"
            ]
        },
        "428_0": {
            "lines": [
                "俱乐部？",
                "原来是圈地自萌啊。"
            ]
        },
        "436_0": {
            "lines": [
                "当然，我可不仅仅代表着星巴克，",
                "我背后的任何牌子都是你的一辈子。"
            ]
        },
        "444_0": {
            "lines": [
                "在正式向外乡人复仇之前，",
                "先把眼前这个刺头先解决掉吧。"
            ]
        },
        "452_0": {
            "lines": [
                "这也是外乡人吗？",
                "有点像薯片只吃可某克的。"
            ]
        },
        "460_0": {
            "lines": [
                "哼……至于可乐，",
                "我承认我们还是太普适化了。"
            ]
        },
        "468_0": {
            "lines": [
                "虽然，不是很清楚你们搞了什么",
                "但是商品拜物教还是太流氓了点。"
            ]
        },
        "476_0": {
            "lines": [
                "就是你们搞的鬼吧？"
            ]
        },
        "484_0": {
            "lines": [
                "一帮小资为了伪装上流来踩别人头，",
                "居然已经开始用这么卑鄙的手段了！"
            ]
        },
        "492_0": {
            "lines": [
                "你不懂的，为了高级感国际感掏钱，",
                "买到的本就是高人一等的愉悦。"
            ]
        },
        "500_0": {
            "lines": [
                "这是他们的选择，也是对我们",
                "产品的一种由衷的认可。"
            ]
        },
        "508_0": {
            "lines": [
                "挑战这精致生活区本就是徒劳的，"
            ]
        },
        "516_0": {
            "lines": [
                "居然还想百万撤离，",
                "实在是有些痴心妄想了。"
            ]
        },
        "524_0": {
            "lines": [
                "以我的力量，就是用乐事薯片，",
                "也可以吸干这家伙的残机。"
            ]
        },
        "532_0": {
            "lines": [
                "小儿科，现在可是EXTRA难度，",
                "碾死这家伙就像碾死一只蚂蚁。"
            ]
        },
        "540_0": {
            "lines": [
                "我也是同感，同——感呢",
                "果然很意气相投呢，我们俩"
            ]
        },
        "548_0": {
            "lines": [
                "我只能说，你们自嗨的能力真不赖，",
                "你俩真是一对苦命鸳鸯啊！"
            ]
        },
        "556_0": {
            "lines": [
                "作为你们把饮料店开到崇明岛的惩罚，",
                "是时候把你们都排斥掉了。"
            ]
        },
        "564_0": {
            "lines": [
                "那么就做好攻击的准备吧。"
            ]
        },
        "572_0": {
            "lines": [
                "将沪所有持有柠檬水的家伙",
                "都束缚起来的当然就是我哦"
            ]
        },
        "580_0": {
            "lines": [
                "分明每一个地方都有",
                "属于自己的防御塔呢。"
            ]
        },
        "588_0": {
            "lines": [
                "讲瞎话，我好歹有雷峰塔呢，"
            ]
        },
        "596_0": {
            "lines": [
                "你要是不放过他们，",
                "就把你压在塔底下！"
            ]
        },
        "604_0": {
            "lines": [
                "不幸的，在快速更迭区域的高铁上，",
                "你可召唤不出你的防御塔呢。"
            ]
        },
        "612_0": {
            "lines": [
                "本来的话，外乡人之流",
                "是不配做我的对手的"
            ]
        },
        "620_0": {
            "lines": [
                "「对星巴克不可撼动的地位口出狂言」",
                "　这一个理由就完全能把你打入地狱"
            ]
        },
        "628_0": {
            "lines": [
                "但是就是这么简单的理由！",
                "我会让你一辈子都后悔的！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "很好，魔都区域的妖气都散尽了，",
                "这下你们成不了气候了！"
            ]
        },
        "42_0": {
            "lines": [
                "哎呀哎呀还是没有击败你呢。",
                "比试结果是我输了呢"
            ]
        },
        "50_0": {
            "lines": [
                "用消费能力衡量人的一切，",
                "现在看来确实有失偏颇。"
            ]
        },
        "58_0": {
            "lines": [
                "是时候好好反思一下了。"
            ]
        },
        "66_0": {
            "lines": [
                "赶紧把外地人们解放出来吧"
            ]
        },
        "74_0": {
            "lines": [
                "喂，东方明珠塔",
                "这样可以吗？"
            ]
        },
        "82_0": {
            "lines": [
                "反正我已经失去了防御塔的力量，",
                "就让外地人想怎么做就怎么做好了。"
            ]
        },
        "90_0": {
            "lines": [
                "拜和这个外乡人相遇所赐",
                "我已经失去战意了啊"
            ]
        },
        "98_0": {
            "lines": [
                "OK——OK——",
                "那么，就解放他们吧"
            ]
        },
        "106_0": {
            "lines": [
                "这样一来就不会有人因为",
                "不喝星巴克被打压了吧？"
            ]
        },
        "114_0": {
            "lines": [
                "尊重个人选择嘛，",
                "何必这样自相残杀呢？"
            ]
        },
        "122_0": {
            "lines": [
                "确实是这样呢……"
            ]
        },
        "130_0": {
            "lines": [
                "精致主义者可都是狡猾又利己的呢"
            ]
        },
        "138_0": {
            "lines": [
                "嗯？"
            ]
        },
        "146_0": {
            "lines": [
                "即使你们打翻了星巴克，",
                "他们还是能想出各种切割的方式。"
            ]
        },
        "154_0": {
            "lines": [
                "不过至少你们应该也不会在乎，在柠檬水",
                "进入这里之后，他们会落荒而逃的。"
            ]
        },
        "162_0": {
            "lines": [
                "你什么时候学会说好话了？"
            ]
        },
        "170_0": {
            "lines": [
                "这么一想的话",
                "不知为何就觉得很生气啊"
            ]
        },
        "178_0": {
            "lines": [
                "喝一杯柠檬水被嘲讽穷酸的，",
                "这口气完全消不下去啊"
            ]
        },
        "186_0": {
            "lines": [
                "现在要不得不回去坐好了，",
                "快要失去维持的力量了。"
            ]
        },
        "194_0": {
            "lines": [
                "一个塔就这么飞过来……"
            ]
        },
        "202_0": {
            "lines": [
                "会好好继续做好广播塔的，",
                "如果我安分下来的话——"
            ]
        },
        "210_0": {
            "lines": [
                "那就说明，",
                "其他防御塔也会失去力量咯？"
            ]
        },
        "218_0": {
            "lines": [
                "某种意义上来说，",
                "确实是这样呢。"
            ]
        },
        "226_0": {
            "lines": [
                "不错呢，我可以保证，"
            ]
        },
        "234_0": {
            "lines": [
                "之后的路上不会再",
                "有人追击你了。"
            ]
        },
        "242_0": {
            "lines": [
                "嘛，我知道了",
                "要是有人追击的话，"
            ]
        },
        "250_0": {
            "lines": [
                "我就会狠狠地把每一个人，",
                "都肘击掉！"
            ]
        },
        "258_0": {
            "lines": [
                "是——"
            ]
        }
    }
}