{
    "0": {
        "34_0": {
            "lines": [
                "总算把那部片子演完了，",
                "可以抽出一点时间去旅游了。"
            ]
        },
        "102_0": {
            "lines": [
                "站住，还没拍完你就走啊？",
                "你的职业素养去哪里了！"
            ]
        },
        "140_0": {
            "lines": [
                "『都说休养生息文景之治，",
                "　光靠文治怎么可能打下帝国基业！』"
            ]
        },
        "156_0": {
            "lines": [
                "煞笔导演写得什么剧本，",
                "让汉景帝跟我说不给唐就导弹！"
            ]
        },
        "164_0": {
            "lines": [
                "你到底演不演了，",
                "你让我怎么拿工钱啊？"
            ]
        },
        "172_0": {
            "lines": [
                "按照剧本，你要被我赶到北极了！"
            ]
        },
        "148_0": {
            "lines": [
                "『不给唐就导弹！』"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "就这样落在你手里，",
                "实在枉愧我的名号啊。"
            ]
        },
        "42_0": {
            "lines": [
                "你是不是忘了你在拍戏？",
                "何况，千古一帝又不光咱们俩。"
            ]
        },
        "50_0": {
            "lines": [
                "这种穿越的剧本啊……",
                "我真是受够了！"
            ]
        },
        "58_0": {
            "lines": [
                "事到如今，",
                "你还有什么话说？"
            ]
        },
        "66_0": {
            "lines": [
                "再无话说，",
                "请速速动手！"
            ]
        },
        "74_0": {
            "lines": [
                "哎，不是，",
                "你TM！"
            ]
        }
    }
}