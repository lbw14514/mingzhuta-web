{
    "0": {
        "34_0": {
            "lines": [
                "列车就是快啊，",
                "不愧是高铁。"
            ]
        },
        "102_0": {
            "lines": [
                "哎呀，哎呀。"
            ]
        },
        "140_0": {
            "lines": [
                "看来又是我睡迷糊了，",
                "现在我应该还在做梦。"
            ]
        },
        "148_0": {
            "lines": [
                "等等是真身！？",
                "这么强！？"
            ]
        },
        "156_0": {
            "lines": [
                "假的，这是戏服。"
            ]
        },
        "164_0": {
            "lines": [
                "有点北方口音，",
                "很奇怪啊哥们。"
            ]
        },
        "172_0": {
            "lines": [
                "你就这样入境沪的目的是什么？"
            ]
        },
        "180_0": {
            "lines": [
                "我不就旅游吗，很简单啊，",
                "中国这么大我就去看看呗。"
            ]
        },
        "188_0": {
            "lines": [
                "明明眼前能看见",
                "那么大一个沪的地图。"
            ]
        },
        "196_0": {
            "lines": [
                "你根本就不够格啊，什么手机，什么学历，",
                "连你这样的人都能入境，那沪成什么了？"
            ]
        },
        "204_0": {
            "lines": [
                "你就这样进入沪的领地，",
                "是十分难受的哦。"
            ]
        },
        "212_0": {
            "lines": [
                "现在，归去来兮，顺便闭麦，",
                "你的猫有回音！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "哎呀哎呀，这事也不能赖我啊。"
            ]
        },
        "42_0": {
            "lines": [
                "如果没法让人看出来你有钱的话，",
                "您也只能在梦里想象去旅游的场景了。"
            ]
        },
        "50_0": {
            "lines": [
                "唔，我不过是想买个宝〇梦玩玩而已。",
                "毕竟我这身也不像没钱的吧？"
            ]
        },
        "58_0": {
            "lines": [
                "是的，毫无疑问您现在，",
                "花的是你的内帑（钱包）"
            ]
        },
        "66_0": {
            "lines": [
                "又不是啥与世隔绝的地方，",
                "我就不信去都去不了。"
            ]
        },
        "74_0": {
            "lines": [
                "恐怕沪无法帮你实现你的愿望。",
                "毕竟买宝〇梦什么的，光有钱还不行。"
            ]
        },
        "82_0": {
            "lines": [
                "我之前说过的，你必须要让人",
                "看得出来你有钱，才能谈别的。"
            ]
        },
        "90_0": {
            "lines": [
                "是吗",
                "我不信。"
            ]
        },
        "98_0": {
            "lines": [
                "但是列车即将到站了，",
                "你不从那个噩梦中醒来……"
            ]
        },
        "106_0": {
            "lines": [
                "即使像我这样准备充分，",
                "或许也有被驱逐的可能性呢。"
            ]
        },
        "114_0": {
            "lines": [
                "就这么想要无伤通关，",
                "就是雪王来了也不太可能的吧？"
            ]
        },
        "122_0": {
            "lines": [
                "什么？"
            ]
        },
        "130_0": {
            "lines": [
                "在外乡人的选择里，",
                "只有一样是那座塔最不可容忍的。"
            ]
        },
        "138_0": {
            "lines": [
                "你这样的安卓人还是不要想了。"
            ]
        }
    }
}