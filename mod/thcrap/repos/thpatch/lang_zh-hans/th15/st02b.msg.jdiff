{
    "0": {
        "34_0": {
            "lines": [
                "怎么感觉精神小伙的攻击",
                "比以往要激烈得多"
            ]
        },
        "42_0": {
            "lines": [
                "看来这帮人已经升级到全新版本了，",
                "我才不怕，我这身衣服比他们的拉风多了。"
            ]
        },
        "110_0": {
            "lines": [
                "我等了三千年了—"
            ]
        },
        "152_0": {
            "lines": [
                "在我深邃的眼中，",
                "流淌着历史与现实的回响……"
            ]
        },
        "160_0": {
            "lines": [
                "又一个吃饱了撑的。"
            ]
        },
        "168_0": {
            "lines": [
                "你把你的一条腿弯在后边，",
                "是磕大拇哥了还是想跟我玩斗鸡？"
            ]
        },
        "176_0": {
            "lines": [
                "你不懂，这是不属于这个世界的仙术，",
                "只有0.0078％的人能够做到。"
            ]
        },
        "184_0": {
            "lines": [
                "我将在雨中净化我自己。"
            ]
        },
        "192_0": {
            "lines": [
                "不过算了",
                "现在王将要休息了。"
            ]
        },
        "200_0": {
            "lines": [
                "不过在此之前，",
                "还是要把面前的蝼蚁斩杀掉啊。"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "哎呀好强"
            ]
        },
        "42_0": {
            "lines": [
                "学不会脱胎换骨，",
                "真是失败呢。"
            ]
        },
        "50_0": {
            "lines": [
                "呀嘞呀嘞，这副身躯实在是脆弱啊。"
            ]
        },
        "58_0": {
            "lines": [
                "折磨枪？",
                "666还有超级拼装。"
            ]
        },
        "66_0": {
            "lines": [
                "因为人间应该",
                "马上就要被净化了……"
            ]
        },
        "74_0": {
            "lines": [
                "我看得先把你净化一下。",
                "现在净化的进度得有91％吧？"
            ]
        },
        "82_0": {
            "lines": [
                "细节91，哥们。",
                "你太懂了哥们。"
            ]
        },
        "90_0": {
            "lines": [
                "现在你已经是时候动身了，",
                "是时候前往疯狂的极乐净土了！"
            ]
        }
    }
}