{
    "0": {
        "214_0": {
            "lines": [
                "不管如何阻挡你们",
                "却总有办法成功破解"
            ]
        },
        "222_0": {
            "lines": [
                "真不甘心",
                "明明差一点点就能把你们阻挡在外了呢"
            ]
        },
        "260_0": {
            "lines": [
                "你是什么人……"
            ]
        },
        "268_0": {
            "lines": [
                "我当了两天剧组的沙雕皇帝，",
                "都没见过这么大的排场。"
            ]
        },
        "276_0": {
            "lines": [
                "没想到竟然会把外乡人送到海上来，",
                "外乡人你们赢了。"
            ]
        },
        "284_0": {
            "lines": [
                "为了喝口廉价饮料，",
                "就要挑战这精致生活区吗？"
            ]
        },
        "292_0": {
            "lines": [
                "你们还真的忍心。"
            ]
        },
        "300_0": {
            "lines": [
                "我喝口柠檬水怎么你了？"
            ]
        },
        "308_0": {
            "lines": [
                "即使你历经千难万险来到这里，",
                "我的眼中也容不下这些痕迹。"
            ]
        },
        "316_0": {
            "lines": [
                "别的地方好歹有自己的防御塔，",
                "你有什么呢？也不会讲方言呢。"
            ]
        },
        "324_0": {
            "lines": [
                "「愣逑杵……」（晋语张呼片方言）",
                "【这是本地一个常见的“语气词”】"
            ]
        },
        "332_0": {
            "lines": [
                "我靠，怎么一点反应也没有。"
            ]
        },
        "340_0": {
            "lines": [
                "该死啊，我老家是秋叶蓝布城，",
                "根本是「球也拦不成」！"
            ]
        },
        "348_0": {
            "lines": [
                "终于有一个没有防御塔的地方了。"
            ]
        },
        "356_0": {
            "lines": [
                "居然要来这里，真是不知天高地厚。"
            ]
        },
        "364_0": {
            "lines": [
                "大境门呢，出来救一下啊！不是哥们。",
                "没办法了，只能硬着头皮硬上了！"
            ]
        },
        "372_0": {
            "lines": [
                "根据沪签管理条例，",
                "你没有陆家嘴区域的工作，"
            ]
        },
        "380_0": {
            "lines": [
                "而且胃里还有蜜雪冰城柠檬水的柠檬籽，",
                "不对，你手里就拿着蜜雪冰城！"
            ]
        },
        "388_0": {
            "lines": [
                "通知你，签证无效，非法入境！"
            ]
        },
        "396_0": {
            "lines": [
                "啊——可恶！"
            ]
        },
        "404_0": {
            "lines": [
                "也就是说我从一开始",
                "就被做局了吗！"
            ]
        },
        "412_0": {
            "lines": [
                "这份无处宣泄的怒火，就在你身上",
                "全部发泄干净吧！"
            ]
        },
        "420_0": {
            "lines": [
                "好啊，来啊！"
            ]
        },
        "428_0": {
            "lines": [
                "即使和廉价饮料已经不共戴天，",
                "只有这份精致会继续纯化外乡人。"
            ]
        },
        "436_0": {
            "lines": [
                "让我见识一下吧！",
                "赌上性命的外地人的可能性！"
            ]
        },
        "444_0": {
            "lines": [
                "见识一下吧！",
                "我这份点到100%的净化机制！"
            ]
        }
    },
    "1": {
        "214_0": {
            "lines": [
                "不管如何阻挡你们",
                "却总有办法成功破解"
            ]
        },
        "222_0": {
            "lines": [
                "真不甘心",
                "明明差一点点就能把你们阻挡在外了呢"
            ]
        },
        "260_0": {
            "lines": [
                "你是什么人……"
            ]
        },
        "268_0": {
            "lines": [
                "我当了两天剧组的沙雕皇帝，",
                "都没见过这么大的排场。"
            ]
        },
        "276_0": {
            "lines": [
                "没想到竟然会把外乡人送到海上来，",
                "外乡人你们赢了，为了喝口廉价饮料。"
            ]
        },
        "284_0": {
            "lines": [
                "哈哈，好像很有趣啊",
                "这份力量，就让我见识一下吧！"
            ]
        },
        "292_0": {
            "lines": [
                "让廉价饮料店开到崇明岛上，",
                "把外乡人送上来"
            ]
        },
        "300_0": {
            "lines": [
                "虽然是个大胆的计划",
                "看来还是奈何不了一点呢"
            ]
        },
        "308_0": {
            "lines": [
                "你说什么？"
            ]
        },
        "316_0": {
            "lines": [
                "像你这种被穷酸的气息包围的",
                "外乡人怎么可能将我打倒"
            ]
        },
        "324_0": {
            "lines": [
                "我的名字你看都能看出来了。"
            ]
        },
        "332_0": {
            "lines": [
                "以我的激光之力可以无条件地",
                "将你赶出去。"
            ]
        },
        "340_0": {
            "lines": [
                "你到目前为止已经坠机了几次",
                "还记得吗？"
            ]
        },
        "348_0": {
            "lines": [
                "你以为我是牢大吗！"
            ]
        },
        "356_0": {
            "lines": [
                "Get不到哀牢山的梗啊，",
                "姑且算作一次坠机好了。"
            ]
        },
        "364_0": {
            "lines": [
                "你这家伙真是随便啊。"
            ]
        },
        "372_0": {
            "lines": [
                "个个都是把有钱写在脸上的富豪！",
                "穷一点也没什么吧！"
            ]
        },
        "380_0": {
            "lines": [
                "外乡人竟然犯下如此愚蠢的失误"
            ]
        },
        "388_0": {
            "lines": [
                "这个穷乡僻壤的家伙比你们设想中的",
                "要弱上几倍几十倍呢"
            ]
        },
        "396_0": {
            "lines": [
                "即使和廉价饮料已经不共戴天，",
                "只有这份精致会继续纯化外乡人。"
            ]
        },
        "404_0": {
            "lines": [
                "不共戴天之敌，雪王啊。你在看着吗！？",
                "此人带来的这些穷酸！这些老土！"
            ]
        }
    }
}