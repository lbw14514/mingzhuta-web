{
    "2": {
        "184_0": {
            "lines": [
                "居然准备踏上返程之旅了吗？"
            ]
        },
        "308_0": {
            "lines": [
                "今天我以沪×风的名号，"
            ]
        },
        "432_0": {
            "lines": [
                "把你对精英生活方式的亵渎，",
                "全都发泄到你的身上吧！"
            ]
        }
    },
    "0": {
        "214_0": {
            "lines": [
                "为了在魔都喝上一杯柠檬水，",
                "你还真的是煞费苦心啊。"
            ]
        },
        "222_0": {
            "lines": [
                "愚蠢的外乡人都已经派外国人来搅局了，",
                "要是再这样下去就真的要失败了。"
            ]
        },
        "230_0": {
            "lines": [
                "现在你要做什么？逃离吗？"
            ]
        },
        "268_0": {
            "lines": [
                "做完了该做的事情，为什么不走？",
                "哪怕你查一下这趟高铁通向何处呢？"
            ]
        },
        "276_0": {
            "lines": [
                "我能说这些事情已经和我没关系了吗？"
            ]
        },
        "284_0": {
            "lines": [
                "至少我要去我的学校（深北莫）",
                "城市发达程度总能和你比一下了吧？"
            ]
        },
        "292_0": {
            "lines": [
                "像对待蜜雪冰城一样对待我，",
                "总归还是行不通的！"
            ]
        },
        "300_0": {
            "lines": [
                "现在你既然来了，那么好，",
                "把被你牵制的外乡人解放吧！"
            ]
        },
        "308_0": {
            "lines": [
                "没有了入沪签证的限制，"
            ]
        },
        "316_0": {
            "lines": [
                "这些外乡人居然已经能自由地进出这里了。",
                "在这片土地上开起了一家家廉价食品店。"
            ]
        },
        "324_0": {
            "lines": [
                "当然，在我的影响下还不会有人光顾他们。"
            ]
        },
        "332_0": {
            "lines": [
                "为了让这种精致感高级感不被扼杀，",
                "我特地从西洋请来一个神仙"
            ]
        },
        "340_0": {
            "lines": [
                "好了快出来吧！",
                "星巴克的女神，雷碧百事祖利啊！"
            ]
        },
        "452_0": {
            "lines": [
                "都已经连星巴克都喝不起了吗？",
                "这样可是不能进入魔都俱乐部的。"
            ]
        },
        "460_0": {
            "lines": [
                "当然，我可不仅仅代表着星巴克，",
                "我背后的任何牌子都是你的一辈子。"
            ]
        },
        "468_0": {
            "lines": [
                "在正式向外乡人复仇之前，",
                "先把眼前这个刺头先解决掉吧。"
            ]
        },
        "476_0": {
            "lines": [
                "这也是外乡人吗？",
                "就像上世纪的杀马特一样。"
            ]
        },
        "484_0": {
            "lines": [
                "看来不能放过你了呢！"
            ]
        },
        "492_0": {
            "lines": [
                "怎么都把我当成杀马特啊喂！"
            ]
        },
        "500_0": {
            "lines": [
                "我虽然不屑于评价什么，",
                "但是你的头发简直难以置信。"
            ]
        },
        "508_0": {
            "lines": [
                "完全就像一个街溜子，",
                "一个混的入。"
            ]
        },
        "516_0": {
            "lines": [
                "Пошёл на хуй！",
                "（俄语：去弥冯的！）"
            ]
        },
        "524_0": {
            "lines": [
                "你要让我抓到必须打你脸你记住！"
            ]
        },
        "532_0": {
            "lines": [
                "随便你了。",
                "就是此人让东方明珠塔感到棘手吗？"
            ]
        },
        "540_0": {
            "lines": [
                "跟我们遇到的所有人都不一样，",
                "这家伙毕竟是国外来留学的。"
            ]
        },
        "548_0": {
            "lines": [
                "拜这家伙所赐",
                "我们的败北已经确定了大半了"
            ]
        },
        "556_0": {
            "lines": [
                "诶？",
                "竟然到了这种程度…"
            ]
        },
        "564_0": {
            "lines": [
                "外乡人真是狡猾，竟让外国人",
                "来搅乱我们的计划。"
            ]
        },
        "572_0": {
            "lines": [
                "哼，真是有趣。既然东方明珠塔都",
                "这样说了，那看来是真人真事呢。"
            ]
        },
        "580_0": {
            "lines": [
                "居然还是被卷进来了。"
            ]
        },
        "588_0": {
            "lines": [
                "但是我也是受害者啊！"
            ]
        },
        "596_0": {
            "lines": [
                "挑战这精致生活区本就是徒劳的！"
            ]
        },
        "604_0": {
            "lines": [
                "即使我开始相信你是外邦人，"
            ]
        },
        "612_0": {
            "lines": [
                "但是这不代表我们不能打破常规！"
            ]
        },
        "620_0": {
            "lines": [
                "「对星巴克不可撼动的地位口出狂言」",
                "　这一个理由就完全能让你满身疮痍"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "两个人一起上还真是恬不知耻呢"
            ]
        },
        "42_0": {
            "lines": [
                "哎呀哎呀还是没有击败你呢。",
                "比试结果是我输了呢"
            ]
        },
        "50_0": {
            "lines": [
                "用消费能力衡量人的一切，",
                "现在看来确实有失偏颇。"
            ]
        },
        "58_0": {
            "lines": [
                "不过毕竟还是要结束了。"
            ]
        },
        "66_0": {
            "lines": [
                "用消费能力把人们区隔开来，",
                "实在是过于魔幻现实主义了。"
            ]
        },
        "74_0": {
            "lines": [
                "当然，你们输了。"
            ]
        },
        "82_0": {
            "lines": [
                "不过，东方明珠塔之前和我说过，"
            ]
        },
        "90_0": {
            "lines": [
                "如果你不是获得了签证检查站的特许，",
                "你根本没有可能再进来。"
            ]
        },
        "98_0": {
            "lines": [
                "看来是那个牢站长派你来的呢。"
            ]
        },
        "106_0": {
            "lines": [
                "她给每一个挑战东方明珠塔的人",
                "都发了一份《魔都旅游焚决》。"
            ]
        },
        "114_0": {
            "lines": [
                "当然，不幸的是支撑异变的妖气，",
                "已经完全被打散掉了。"
            ]
        },
        "122_0": {
            "lines": [
                "那么现在也是时候了，",
                "把被你们控制的外乡人释放吧。"
            ]
        },
        "130_0": {
            "lines": [
                "喂，东方明珠塔",
                "这样可以吗？"
            ]
        },
        "138_0": {
            "lines": [
                "反正我已经失去了防御塔的力量，",
                "就让外地人想怎么做就怎么做好了。"
            ]
        },
        "146_0": {
            "lines": [
                "不过，那些精致主义者的想法，"
            ]
        },
        "154_0": {
            "lines": [
                "我没有能力和力量去改变，",
                "我也不会去这样做。"
            ]
        },
        "162_0": {
            "lines": [
                "即使星巴克不能成为上流标志，",
                "也还会有其他的类似物代替的。"
            ]
        },
        "170_0": {
            "lines": [
                "OK——OK——",
                "那么，就解放他们吧"
            ]
        },
        "178_0": {
            "lines": [
                "这样一来就不会有人因为",
                "不喝星巴克被打压了吧？"
            ]
        },
        "186_0": {
            "lines": [
                "虽然没有那么容易完成任务，",
                "但是也还是能打压那些无冕之王的。"
            ]
        },
        "194_0": {
            "lines": [
                "让我去对付他们，",
                "这就超出我能力之外了啊……"
            ]
        },
        "202_0": {
            "lines": [
                "嗯？",
                "你说什么了吗？"
            ]
        },
        "210_0": {
            "lines": [
                "糟糕了，竟然出声了",
                "我什么都没说哦"
            ]
        },
        "218_0": {
            "lines": [
                "担心什么的就不必了啊"
            ]
        },
        "226_0": {
            "lines": [
                "我现在不得不飞回去了。"
            ]
        },
        "234_0": {
            "lines": [
                "回去重新坐在那里，",
                "做一个无意识的广播塔。"
            ]
        },
        "242_0": {
            "lines": [
                "当然，不会发射激光。"
            ]
        },
        "250_0": {
            "lines": [
                "那么……"
            ]
        },
        "258_0": {
            "lines": [
                "完事了呢。"
            ]
        },
        "266_0": {
            "lines": [
                "何意味？"
            ]
        },
        "274_0": {
            "lines": [
                "「魔都」的意思可不是",
                "住着恶魔的地方呢。"
            ]
        },
        "282_0": {
            "lines": [
                "何况所谓的恶魔已经被打压了，",
                "甚至这座塔连话都不能说了。"
            ]
        },
        "290_0": {
            "lines": [
                "不是吧？",
                "塔会说话还不奇怪？"
            ]
        },
        "298_0": {
            "lines": [
                "归根到底还是白挣扎了一次，",
                "该回去改进星巴克了。"
            ]
        },
        "306_0": {
            "lines": [
                "是时候把它做成更加",
                "普适的饮品了呢。"
            ]
        },
        "314_0": {
            "lines": [
                "虽然本来就是这样罢了……"
            ]
        }
    }
}