{
    "0": {
        "34_0": {
            "lines": [
                "这里是咖啡馆啊……？"
            ]
        },
        "42_0": {
            "lines": [
                "不知道为什么这些人这么高傲。"
            ]
        },
        "50_0": {
            "lines": [
                "有人在吗？",
                "能来杯咖啡吗？"
            ]
        },
        "152_0": {
            "lines": [
                "…………"
            ]
        },
        "160_0": {
            "lines": [
                "你们这里有菜单吗？"
            ]
        },
        "168_0": {
            "lines": [
                "哪来的土鳖？"
            ]
        },
        "176_0": {
            "lines": [
                "不知道来这里要穿正装吗？"
            ]
        },
        "184_0": {
            "lines": [
                "我不就是喝个咖啡吗！"
            ]
        },
        "192_0": {
            "lines": [
                "我虽然不知道为什么你要这样，",
                "但是我觉得你多少有点问题的。"
            ]
        },
        "200_0": {
            "lines": [
                "您毕竟是干服务业的吧？",
                "顾客就是上帝的吧？"
            ]
        },
        "208_0": {
            "lines": [
                "哼，虽然确实是……"
            ]
        },
        "216_0": {
            "lines": [
                "承认了啊",
                "这么简单就承认了啊"
            ]
        },
        "224_0": {
            "lines": [
                "……那我不请你，你自己出去吧。"
            ]
        },
        "232_0": {
            "lines": [
                "来这里的都是些志同道合的高端玩家，",
                "你们这些路边逛茶馆的有资格来这吗？"
            ]
        },
        "240_0": {
            "lines": [
                "不好意思，这咖啡我不卖给你。"
            ]
        },
        "248_0": {
            "lines": [
                "你们这里的人都是这样的吗？",
                "不过算了，我又不是喝不起。"
            ]
        },
        "256_0": {
            "lines": [
                "服务业一定要会服务！",
                "这都不懂咋开的店啊！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "行吧，这杯咖啡就允许你点了。",
                "该给多少给多少。"
            ]
        },
        "42_0": {
            "lines": [
                "对了，最低消费额200沪币。"
            ]
        },
        "50_0": {
            "lines": [
                "别让我看见你亵渎这杯咖啡，",
                "你最好真的会喝。"
            ]
        },
        "58_0": {
            "lines": [
                "切，不就是一杯咖啡吗，装什么装？",
                "（抿了一口）"
            ]
        },
        "66_0": {
            "lines": [
                "咖啡是你这么喝的吗？"
            ]
        },
        "74_0": {
            "lines": [
                "你得溜着边喝。",
                "都不吧唧嘴的你咋？"
            ]
        },
        "82_0": {
            "lines": [
                "你看看这里哪个人",
                "不像看砂子一样看你？"
            ]
        },
        "90_0": {
            "lines": [
                "本来不预约就该把你赶出去了。"
            ]
        },
        "98_0": {
            "lines": [
                "你特么事真多。你这咖啡也没啥特点啊？"
            ]
        },
        "106_0": {
            "lines": [
                "你就胡说吧。我这可是独家技术。",
                "还有，拍照另外50块啊！"
            ]
        },
        "114_0": {
            "lines": [
                "我们Simpleton咖啡店是你随便的？",
                "真是一点艺术也不懂，土包子。"
            ]
        },
        "122_0": {
            "lines": [
                "什么？"
            ]
        },
        "130_0": {
            "lines": [
                "那你咖啡杯底下哪来的星巴克？",
                "难道是从隔壁捡来的咖啡杯吗？"
            ]
        },
        "138_0": {
            "lines": [
                "关你鸟事，",
                "每一杯咖啡都是我的艺术。"
            ]
        },
        "146_0": {
            "lines": [
                "你都不懂得欣赏一下，",
                "每一杯咖啡都是有情感表达的！"
            ]
        },
        "154_0": {
            "lines": [
                "这次算我倒霉碰上你这个硬茬子了。",
                "我不收你50的拍照费得了。"
            ]
        },
        "162_0": {
            "lines": [
                "当然，你不会把这事说出去的。",
                "对吧？一言为定啊！"
            ]
        },
        "170_0": {
            "lines": [
                "你想得美，谁跟你一伙的啊？",
                "我第一站来你这里真是遭牢罪了！"
            ]
        },
        "178_0": {
            "lines": [
                "神特么“我们只招待朋友不招待上帝”"
            ]
        },
        "186_0": {
            "lines": [
                "那我们真的没办法做朋友了。",
                "毕竟朋友需要互相理解。"
            ]
        },
        "194_0": {
            "lines": [
                "可是你不理解我，还要我理解你。",
                "甚至你还骂我！"
            ]
        },
        "202_0": {
            "lines": [
                "我骂你，那是你有病，",
                "你没病我能骂你吗？咱讲道理的！"
            ]
        },
        "210_0": {
            "lines": [
                "你骂我，那还是你有病，",
                "你没病凭啥骂我？"
            ]
        },
        "218_0": {
            "lines": [
                "我是来这里找专业人士的，",
                "怎么都是你们这帮土包子来啊！"
            ]
        }
    }
}