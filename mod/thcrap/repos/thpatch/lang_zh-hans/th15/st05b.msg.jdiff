{
    "2": {
        "50_0": {
            "lines": [
                "呀啊啊啊啊！",
                "禁止携带外来食品进入园区！"
            ]
        },
        "180_0": {
            "lines": [
                "保安们啊，速度快一点！"
            ]
        },
        "330_0": {
            "lines": [
                "　　　It's Dixxey Empire!　　　",
                "　　　欢迎来到梦幻的世界！"
            ]
        }
    },
    "0": {
        "34_0": {
            "lines": [
                "都是烟花之类的东西，真有意思。"
            ]
        },
        "42_0": {
            "lines": [
                "这么多店铺都躁狂起来了，真神秘。"
            ]
        },
        "50_0": {
            "lines": [
                "远处的东方明珠塔变得奇怪起来了呢。",
                "怎么好像塔顶放出了红光？"
            ]
        },
        "58_0": {
            "lines": [
                "不是哥们，有点搞，",
                "我就是来旅个游，真要被针对吗？"
            ]
        },
        "66_0": {
            "lines": [
                "不过还好，这里还是有蜜雪冰城的，",
                "还是买一杯吧，比刚才那咖啡好，真的。"
            ]
        },
        "74_0": {
            "lines": [
                "明明什么都没有看到，",
                "居然变得这么累，离谱。"
            ]
        },
        "82_0": {
            "lines": [
                "刚才那是什么？",
                "激光打过来了吗……"
            ]
        },
        "180_0": {
            "lines": [
                "真是的，我也是从这么多攻击里",
                "穿过来的人啊。"
            ]
        },
        "188_0": {
            "lines": [
                "有两下子嘛"
            ]
        },
        "196_0": {
            "lines": [
                "你谁啊"
            ]
        },
        "204_0": {
            "lines": [
                "我是妙妙屋的主人：",
                "克劳恩米奇！"
            ]
        },
        "212_0": {
            "lines": [
                "现在我的兄弟们还不在我身边，",
                "但是你愿意来看看我的妙妙屋吗？"
            ]
        },
        "220_0": {
            "lines": [
                "给我干哪来了这是，",
                "难不成我真在迪〇尼吗？"
            ]
        },
        "228_0": {
            "lines": [
                "哦呀，看来是买了票的。"
            ]
        },
        "236_0": {
            "lines": [
                "迪〇尼啦，就是最著名的乐园啊。",
                "我们完全会保证你的安全。"
            ]
        },
        "244_0": {
            "lines": [
                "啊对了，头儿那边跟我说了，",
                "既然咱可以提供餐饮，那么外菜莫入。"
            ]
        },
        "252_0": {
            "lines": [
                "保证安全，那我可以放心玩了。",
                "票也买了让我进去呗。"
            ]
        },
        "260_0": {
            "lines": [
                "赶快玩完了回去报到了。"
            ]
        },
        "268_0": {
            "lines": [
                "但是在此之前先让我把这",
                "柠檬水先喝完再说。"
            ]
        },
        "276_0": {
            "lines": [
                "要是有外带食物的话，",
                "不必手下留情的说。"
            ]
        },
        "284_0": {
            "lines": [
                "既然还是柠檬水，",
                "你现在就是全沪最危险的人了！"
            ]
        },
        "292_0": {
            "lines": [
                "在东方明珠执行净化之前，",
                "我准备先会会你！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "哈…哈…哈…"
            ]
        },
        "42_0": {
            "lines": [
                "何，何意味……？"
            ]
        },
        "50_0": {
            "lines": [
                "我分明已经得到了",
                "东方明珠塔的加成。"
            ]
        },
        "58_0": {
            "lines": [
                "为什么你还能活下来啊？",
                "不应该是毫无还手之力吗？"
            ]
        },
        "66_0": {
            "lines": [
                "我不是买不起星巴克，"
            ]
        },
        "74_0": {
            "lines": [
                "但是我可不会把咖啡当水喝。"
            ]
        },
        "82_0": {
            "lines": [
                "你这家伙……不，阁下",
                "法务部都奈何不了你吗！？"
            ]
        },
        "90_0": {
            "lines": [
                "刚才你翻我行李箱拿走的食物，",
                "该还给我了吧？"
            ]
        },
        "98_0": {
            "lines": [
                "为什么外乡人会在这里……？",
                "和说好的不一样啊"
            ]
        },
        "106_0": {
            "lines": [
                "你这句话说出来就有点大脑升级了，",
                "我可是旅游的，难道一定是本地人吗？"
            ]
        },
        "114_0": {
            "lines": [
                "只有本地人才会有这种随和的状态"
            ]
        },
        "122_0": {
            "lines": [
                "可是现在，哥们，你大难临头了。",
                "难道就没有人提醒过你吗？"
            ]
        },
        "130_0": {
            "lines": [
                "你所见到的这座塔，最讨厌的，",
                "就是那杯柠檬水啊。"
            ]
        },
        "138_0": {
            "lines": [
                "那我只能买一两百的套皮咖啡吗？"
            ]
        },
        "146_0": {
            "lines": [
                "当然可以，这种的话是不会",
                "完全拒绝的。"
            ]
        },
        "154_0": {
            "lines": [
                "活下去的关键，不是生活水平多高，",
                "而是你到底能不能展示出你有钱花。"
            ]
        },
        "162_0": {
            "lines": [
                "这个地方就是这样的啦，",
                "把钱交给高级感而已了。"
            ]
        },
        "170_0": {
            "lines": [
                "……现在你可以把我的食物还给我了吧？"
            ]
        },
        "178_0": {
            "lines": [
                "我这玩意还要留着回去路上吃呢。",
                "再说你不让带，也不就买你家高价的吗？"
            ]
        },
        "186_0": {
            "lines": [
                "现在你松口还来得及，",
                "你要是交出来的话，"
            ]
        },
        "194_0": {
            "lines": [
                "……就允许你的老冯返航。"
            ]
        }
    }
}