{
    "0": {
        "34_0": {
            "lines": [
                "啊，我终于要回家了，",
                "终于要回家了！"
            ]
        },
        "102_0": {
            "lines": [
                "你这个人怎么回事？"
            ]
        },
        "140_0": {
            "lines": [
                "这趟列车上的人物，",
                "明明全都是来旅游的啊。"
            ]
        },
        "148_0": {
            "lines": [
                "总是嚷嚷着回家……",
                "难道你真的是上海人！？"
            ]
        },
        "156_0": {
            "lines": [
                "废话，我出去挣点零花钱回来了，",
                "吃一个月拼好饭为买苹果手机攒钱。"
            ]
        },
        "164_0": {
            "lines": [
                "你不说话还好，",
                "原来你用的甚至不是苹果手机。"
            ]
        },
        "172_0": {
            "lines": [
                "那你不就是安卓人吗？",
                "至于前往魔都，更是想都别想！"
            ]
        },
        "180_0": {
            "lines": [
                "不是你这人啥意思？回家都不让？",
                "本来临走前拼好饭被偷了就不高兴！"
            ]
        },
        "188_0": {
            "lines": [
                "在上海定居了的人，",
                "消费能力居然只是拼好饭？"
            ]
        },
        "196_0": {
            "lines": [
                "这种话，根本不会有人相信的！",
                "敢骗我，一会儿可有你好受的。"
            ]
        },
        "204_0": {
            "lines": [
                "已经死去的电子宠物，",
                "现在是时候冲击你了！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "！？强强？！",
                "你这人有点东西！"
            ]
        },
        "42_0": {
            "lines": [
                "可是你的行头在我看来，",
                "根本不像是魔都的居民啊。"
            ]
        },
        "50_0": {
            "lines": [
                "现在我也没时间求证了，",
                "我只能警告你一下了。"
            ]
        },
        "58_0": {
            "lines": [
                "数以千百倍的精致与浮华，",
                "像瘟疫一样席卷了这里。"
            ]
        },
        "66_0": {
            "lines": [
                "这些东西足以吞噬每一个",
                "想要践踏秩序的「外乡人」。"
            ]
        },
        "74_0": {
            "lines": [
                "感觉，你像是有点魔都口音的人。"
            ]
        },
        "82_0": {
            "lines": [
                "「侬搿额人真是阿木林一只，介拎勿清。」",
                "（吴语：你真是傻瓜一个，这么笨啊。）"
            ]
        },
        "90_0": {
            "lines": [
                "你能不能好好看清楚啊？",
                "我就是个坐车回家的本地人啊喂！"
            ]
        },
        "98_0": {
            "lines": [
                "分明是你找茬在先的吧？",
                "我出去赚点换手机的钱都不行？"
            ]
        },
        "106_0": {
            "lines": [
                "真是我有眼无珠了，",
                "您吉祥啊！"
            ]
        },
        "114_0": {
            "lines": [
                "自从好多大富翁来这里开店之后，",
                "反而感觉我越来越像外来的了。"
            ]
        },
        "122_0": {
            "lines": [
                "算了，谁让我老爹让我出去打工的，",
                "要不然买个手机还有这么难的啊！"
            ]
        }
    }
}