{
    "0": {
        "214_0": {
            "lines": [
                "不管如何阻挡你们",
                "却总有办法成功破解"
            ]
        },
        "222_0": {
            "lines": [
                "真不甘心",
                "明明差一点点就能把你们阻挡在外了呢"
            ]
        },
        "260_0": {
            "lines": [
                "你就是他们口中说的",
                "毁灭一切的魔丸吗？"
            ]
        },
        "268_0": {
            "lines": [
                "我只会纯化掉你罢了。"
            ]
        },
        "276_0": {
            "lines": [
                "啊？"
            ]
        },
        "284_0": {
            "lines": [
                "没想到竟然会把外乡人送到海上来，",
                "外乡人你们赢了。"
            ]
        },
        "292_0": {
            "lines": [
                "为了喝口廉价饮料，",
                "就要挑战这精致生活区吗？"
            ]
        },
        "300_0": {
            "lines": [
                "我的设想还是太天真了",
                "这谁能挡得住啊！"
            ]
        },
        "308_0": {
            "lines": [
                "我的本意便是离开，",
                "我不过是喝了杯柠檬水罢了。"
            ]
        },
        "316_0": {
            "lines": [
                "去找蜜雪冰城或许是穷，"
            ]
        },
        "324_0": {
            "lines": [
                "但喝柠檬水一定是酸！穷酸！"
            ]
        },
        "332_0": {
            "lines": [
                "即使你历经千难万险来到这里……"
            ]
        },
        "340_0": {
            "lines": [
                "但还是让我来招待一下",
                "努力至今的你吧"
            ]
        },
        "348_0": {
            "lines": [
                "毕竟你的防御塔怎么和我抗衡呢？"
            ]
        },
        "356_0": {
            "lines": [
                "那又怎么样，毕竟我还有",
                "西湖的醋鱼！"
            ]
        },
        "364_0": {
            "lines": [
                "而且把醋鱼丢进西湖的这份闷气",
                "不让我发泄个干净我是不会罢休的！"
            ]
        },
        "372_0": {
            "lines": [
                "何况我还有雷峰塔呢！"
            ]
        },
        "380_0": {
            "lines": [
                "很抱歉通知你，由于你没有",
                "古驰、LV、哈根达斯等店的消费记录，"
            ]
        },
        "388_0": {
            "lines": [
                "且没有陆家嘴CBD的工作记录。",
                "现通知您，签证无效，禁止入境！"
            ]
        },
        "396_0": {
            "lines": [
                "即使和廉价饮料已经不共戴天，",
                "只有这份精致会继续纯化外乡人。"
            ]
        },
        "404_0": {
            "lines": [
                "你也见识一下吧！",
                "赌上性命的乡毋宁的挣扎！"
            ]
        }
    },
    "1": {
        "214_0": {
            "lines": [
                "不管如何拟定计划",
                "却总有办法成功破解"
            ]
        },
        "222_0": {
            "lines": [
                "但是，就这种激光都撑不住吗？",
                "假装自己精致，还是露出了破绽啊！"
            ]
        },
        "260_0": {
            "lines": [
                "你就是他们口中说的上海明珠塔吗？",
                "难道这座塔不是电视塔吗？"
            ]
        },
        "268_0": {
            "lines": [
                "秘密改造罢了。"
            ]
        },
        "276_0": {
            "lines": [
                "这战斗场面，我演了几年短剧，",
                "都一点都没见过的啊！"
            ]
        },
        "284_0": {
            "lines": [
                "为了打败我的计划，",
                "竟然会把乡毋宁送到海上来"
            ]
        },
        "292_0": {
            "lines": [
                "虽然是个大胆的计划",
                "看来还是功亏一篑呢"
            ]
        },
        "300_0": {
            "lines": [
                "啊？"
            ]
        },
        "308_0": {
            "lines": [
                "像你这种防御塔机能失效的家伙，",
                "怎么可能将我打倒？"
            ]
        },
        "316_0": {
            "lines": [
                "你以为喝个主理人咖啡就算有钱人吗？"
            ]
        },
        "324_0": {
            "lines": [
                "你肚子里的柠檬籽，",
                "在沪地就是不折不扣的毒药啊！"
            ]
        },
        "332_0": {
            "lines": [
                "你到目前为止已经miss了几次",
                "还记得吗？"
            ]
        },
        "340_0": {
            "lines": [
                "好啊，原来我一开始，",
                "就被你这家伙做局了！"
            ]
        },
        "348_0": {
            "lines": [
                "看起来好像我的体力确实被弱化了呢，",
                "毕竟被捶打了太多次了……"
            ]
        },
        "356_0": {
            "lines": [
                "但是西湖醋鱼和雷峰塔，",
                "一定还是会保护我的！"
            ]
        },
        "364_0": {
            "lines": [
                "为了喝饮料去蜜雪冰城或许是穷。"
            ]
        },
        "372_0": {
            "lines": [
                "可是喝柠檬水就是酸！",
                "合起来就是“穷酸”！"
            ]
        },
        "380_0": {
            "lines": [
                "即使和廉价饮料已经不共戴天，",
                "只有这份精致会继续纯化外乡人。"
            ]
        },
        "388_0": {
            "lines": [
                "不共戴天之敌，雪王啊。你在看着吗！？",
                "此人在魔都的间隙之中挣扎的样子！"
            ]
        }
    }
}