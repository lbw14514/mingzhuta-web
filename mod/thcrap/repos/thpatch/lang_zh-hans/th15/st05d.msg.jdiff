{
    "2": {
        "50_0": {
            "lines": [
                "呀啊啊啊啊！",
                "禁止携带外来食品进入园区！"
            ]
        },
        "180_0": {
            "lines": [
                "保安们啊，速度快一点！"
            ]
        },
        "330_0": {
            "lines": [
                "　　　It's Dixxey Empire!　　　",
                "　　　欢迎来到梦幻的世界！"
            ]
        }
    },
    "0": {
        "34_0": {
            "lines": [
                "这里就是迪〇尼了。"
            ]
        },
        "42_0": {
            "lines": [
                "稍微吃点什么东西吧，",
                "然后看看这里有没有什么很大的差别。"
            ]
        },
        "50_0": {
            "lines": [
                "这个城市的气氛看起来也奇怪了，",
                "感觉被什么东西包围了。"
            ]
        },
        "58_0": {
            "lines": [
                "看来买了一杯蜜雪冰城",
                "确实能把「它」吸引出来呢。"
            ]
        },
        "66_0": {
            "lines": [
                "说来疑问才不是这里啊"
            ]
        },
        "74_0": {
            "lines": [
                "说到底，为什么",
                "没有用激光来打我呢？"
            ]
        },
        "172_0": {
            "lines": [
                "等一下等一下"
            ]
        },
        "180_0": {
            "lines": [
                "你的票在哪里？",
                "手机上那个二维码扫一下"
            ]
        },
        "188_0": {
            "lines": [
                "顺便说下这里不能外带食品。"
            ]
        },
        "196_0": {
            "lines": [
                "哈？"
            ]
        },
        "204_0": {
            "lines": [
                "和其他的景点比起来好像确实",
                "规矩不太一样……"
            ]
        },
        "212_0": {
            "lines": [
                "我去什么地方都没有人",
                "能扣下我背包里的食物……"
            ]
        },
        "220_0": {
            "lines": [
                "你以为我是谁啊"
            ]
        },
        "228_0": {
            "lines": [
                "我可是迪〇尼的化身",
                "克劳恩米奇"
            ]
        },
        "236_0": {
            "lines": [
                "我们欢迎你们参观我们的妙妙屋，",
                "但是你们守规矩，这才是契约精神。"
            ]
        },
        "244_0": {
            "lines": [
                "不过具体的规矩得我们来定，",
                "乱丢垃圾污染我们的环境可不行。"
            ]
        },
        "252_0": {
            "lines": [
                "所以你的意思是我去你们那里，",
                "然后买你们贵得要死的东西？"
            ]
        },
        "260_0": {
            "lines": [
                "你不要忘了这是魔都！",
                "连这种消费程度都达不到吗？"
            ]
        },
        "268_0": {
            "lines": [
                "哎哟还拿着柠檬水，还有外带咖啡？",
                "你现在可是全魔都最危险的人了！"
            ]
        },
        "276_0": {
            "lines": [
                "在被明珠塔净化前，就让我驱逐你吧！",
                "坠入地狱吧，你这个杀马特！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "哈…哈…哈…"
            ]
        },
        "42_0": {
            "lines": [
                "我特么不是杀马特啊！",
                "你们怎么都拿我头发说事？"
            ]
        },
        "50_0": {
            "lines": [
                "何，何意味……？"
            ]
        },
        "58_0": {
            "lines": [
                "不是我们只要定好规矩了，",
                "这帮人就会乖乖掏钱的吗？"
            ]
        },
        "66_0": {
            "lines": [
                "从根本上就被忽悠了啊，",
                "说好的大家都在搞精致生活呢？"
            ]
        },
        "74_0": {
            "lines": [
                "喂喂，这些话",
                "是谁告诉你的？"
            ]
        },
        "82_0": {
            "lines": [
                "东方明珠塔啊"
            ]
        },
        "90_0": {
            "lines": [
                "要不我为啥说你喝柠檬水很危险，",
                "它可是对这种低质量消费深恶痛绝的。"
            ]
        },
        "98_0": {
            "lines": [
                "搞什么？我在大学就喜欢喝，",
                "你以为我掏不起喝更好东西的钱吗？"
            ]
        },
        "106_0": {
            "lines": [
                "我虽然也不太明白",
                "不过估计它不会听你狡辩的。"
            ]
        },
        "114_0": {
            "lines": [
                "哼——，反正我是看到了，",
                "在这里买个东西还看你穿什么。"
            ]
        },
        "122_0": {
            "lines": [
                "你要是不穿点啥名牌的东西，",
                "都能把你从队伍里撵出去是吧？"
            ]
        },
        "130_0": {
            "lines": [
                "原本不是这样的吧？",
                "大家都按照自己的需求买东西。"
            ]
        },
        "138_0": {
            "lines": [
                "就像我手里的柠檬水一样，",
                "我喜欢它，我就买它来喝。"
            ]
        },
        "146_0": {
            "lines": [
                "阁下实在是有自己的一番见解，",
                "在不久前的异变之前确实如此。"
            ]
        },
        "154_0": {
            "lines": [
                "我虽然心里现在实在是不满。"
            ]
        },
        "162_0": {
            "lines": [
                "但是我的目的就是把它引出来，",
                "然后击败它，这样就能恢复正常了吧？"
            ]
        },
        "170_0": {
            "lines": [
                "肯定错不了了."
            ]
        },
        "178_0": {
            "lines": [
                "那个主理人owner说的，",
                "现在我就是在做激怒它的事情。"
            ]
        },
        "186_0": {
            "lines": [
                "对了，你刚才收掉我的咖啡，还给我。",
                "那不是我喝的，是拿回去化验的。"
            ]
        },
        "194_0": {
            "lines": [
                "现在我也没有退身的余地了。"
            ]
        },
        "202_0": {
            "lines": [
                "作为一个外邦人，它应该不会针对我。",
                "毕竟网上的记录我看了。"
            ]
        },
        "210_0": {
            "lines": [
                "上海明珠塔见到外国人的话，",
                "应该会放弃任何攻击的。"
            ]
        }
    }
}