{
    "0": {
        "34_0": {
            "lines": [
                "浙江居然离上海这么近",
                "这句话真是一句话啊！"
            ]
        },
        "102_0": {
            "lines": [
                "我等了好几百年了—"
            ]
        },
        "144_0": {
            "lines": [
                "等到你这么有趣的家伙来，",
                "真是可以酣畅淋漓地决斗一场了……"
            ]
        },
        "152_0": {
            "lines": [
                "跟你决斗简直是一句鬼话！"
            ]
        },
        "160_0": {
            "lines": [
                "能不能不要乱搞？"
            ]
        },
        "168_0": {
            "lines": [
                "你，知道我到底是",
                "什么人吗？"
            ]
        },
        "176_0": {
            "lines": [
                "我可是你世代的仇人，",
                "博丽灵梦的化身！"
            ]
        },
        "184_0": {
            "lines": [
                "十年前的仇恨，",
                "难道就不报了吗！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "现在来看，这副凡人的皮囊，",
                "实在是太弱了啊……"
            ]
        },
        "42_0": {
            "lines": [
                "你是真的疯了。"
            ]
        },
        "50_0": {
            "lines": [
                "姑且说你是嘉豪，我还能相信。"
            ]
        },
        "58_0": {
            "lines": [
                "不是所有名字是嘉豪的人才是嘉豪，",
                "是不是「嘉豪」，我自己说了算！"
            ]
        },
        "66_0": {
            "lines": [
                "嗯……",
                "也就是说"
            ]
        },
        "74_0": {
            "lines": [
                "你其实是个大号的魔丸吧。",
                "什么时候变成杀马特超人？"
            ]
        },
        "82_0": {
            "lines": [
                "你要这么说的话我真的大受启发，",
                "简直想要直接跑到雨中沐浴一场！"
            ]
        },
        "90_0": {
            "lines": [
                "只要我戴上那属于杀马特的头套，",
                "随便找个附近的展会走进去，"
            ]
        },
        "98_0": {
            "lines": [
                "岂不是有千万现场的美少女，",
                "抢着找我要签名吗？"
            ]
        },
        "106_0": {
            "lines": [
                "这家伙的脑子彻底坏掉了"
            ]
        },
        "114_0": {
            "lines": [
                "这就是我的行动路线啊！"
            ]
        },
        "122_0": {
            "lines": [
                "这一次就算你赢了好了，",
                "三十年河东三十年河西……"
            ]
        },
        "130_0": {
            "lines": [
                "现在我要去实践我的计划了，",
                "后会有期了！"
            ]
        }
    }
}