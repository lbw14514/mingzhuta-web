{
    "2": {
        "184_0": {
            "lines": [
                "居然准备踏上返程之旅了吗？"
            ]
        },
        "308_0": {
            "lines": [
                "今天我以沪×风的名号，"
            ]
        },
        "432_0": {
            "lines": [
                "把你对精英生活方式的亵渎，",
                "全都发泄到你的身上吧！"
            ]
        }
    },
    "0": {
        "214_0": {
            "lines": [
                "为了在魔都喝上一杯柠檬水，",
                "你还真的是煞费苦心啊。"
            ]
        },
        "222_0": {
            "lines": [
                "愚蠢的外乡人都已经派人来搅局了，",
                "要是再这样下去就真的要失败了。"
            ]
        },
        "260_0": {
            "lines": [
                "好啊我就知道又是你！"
            ]
        },
        "268_0": {
            "lines": [
                "这一次就是决出胜负的时刻！"
            ]
        },
        "276_0": {
            "lines": [
                "没有了入沪签证的限制，"
            ]
        },
        "284_0": {
            "lines": [
                "这些外乡人居然已经能自由地进出这里了。",
                "在这片土地上开起了一家家廉价食品店。"
            ]
        },
        "292_0": {
            "lines": [
                "当然，在我的影响下还不会有人光顾他们。"
            ]
        },
        "300_0": {
            "lines": [
                "为了让这种精致感高级感不被扼杀，",
                "我特地从西洋请来一个神仙"
            ]
        },
        "308_0": {
            "lines": [
                "好了快出来吧！",
                "星巴克的女神，雷碧百事祖利啊！"
            ]
        },
        "420_0": {
            "lines": [
                "都已经连星巴克都喝不起了吗？",
                "这样可是不能进入魔都俱乐部的。"
            ]
        },
        "428_0": {
            "lines": [
                "当然，我可不仅仅代表着星巴克，",
                "我背后的任何牌子都是你的一辈子。"
            ]
        },
        "436_0": {
            "lines": [
                "在正式向外乡人复仇之前，",
                "先把眼前这个刺头先解决掉吧。"
            ]
        },
        "444_0": {
            "lines": [
                "这也是外乡人吗？",
                "有点像薯片只吃可某克的。"
            ]
        },
        "452_0": {
            "lines": [
                "哼……至于可乐，",
                "我承认我们还是太普适化了。"
            ]
        },
        "460_0": {
            "lines": [
                "唔、敌人有两个？"
            ]
        },
        "468_0": {
            "lines": [
                "你只看到两个吗？",
                "哈哈哈…"
            ]
        },
        "476_0": {
            "lines": [
                "这样也好。",
                "就是此人让东方明珠塔感到棘手吗？"
            ]
        },
        "484_0": {
            "lines": [
                "局势开始紧张起来了呢。"
            ]
        },
        "492_0": {
            "lines": [
                "拜这人类所赐，我们的",
                "败北已经确定了大半了。"
            ]
        },
        "500_0": {
            "lines": [
                "诶？",
                "竟然到了这种程度…"
            ]
        },
        "508_0": {
            "lines": [
                "外乡人就是这么狡猾，竟让本地人",
                "来搅乱我们的计划。"
            ]
        },
        "516_0": {
            "lines": [
                "哼，真是有趣。既然东方明珠塔都",
                "这样说了，那看来是真人真事呢。"
            ]
        },
        "524_0": {
            "lines": [
                "我只能说，你们自嗨的能力真不赖。"
            ]
        },
        "532_0": {
            "lines": [
                "「侬两额宁真额老配额！」",
                "（吴语：你俩真是一对苦命鸳鸯）"
            ]
        },
        "540_0": {
            "lines": [
                "你怎么也开始讲方言了呢？"
            ]
        },
        "548_0": {
            "lines": [
                "要知道你的防御塔。"
            ]
        },
        "556_0": {
            "lines": [
                "可是站在你面前，",
                "跃跃欲试准备击败你的！"
            ]
        },
        "564_0": {
            "lines": [
                "胜负什么的似乎已经没那么重要了。"
            ]
        },
        "572_0": {
            "lines": [
                "毕竟，死并不可怕，死是凉爽的夏夜，",
                "可供人无忧地安眠。"
            ]
        },
        "580_0": {
            "lines": [
                "是这样啊？",
                "那我就安心了。"
            ]
        },
        "588_0": {
            "lines": [
                "如果我打倒了你，我就用蒸笼蒸馒头，",
                "笼，可是帝王之蒸啊！"
            ]
        },
        "596_0": {
            "lines": [
                "作为你们把饮料店开到崇明岛的惩罚，",
                "是时候把你们都排斥掉了。"
            ]
        },
        "604_0": {
            "lines": [
                "本来的话，外乡人之流是",
                "不配做我的对手的。"
            ]
        },
        "612_0": {
            "lines": [
                "「对星巴克不可撼动的地位口出狂言」",
                "　这一个理由就完全能把你打入地狱"
            ]
        },
        "620_0": {
            "lines": [
                "就是这么一个简单的理由！",
                "我会让你死了都会后悔的！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "说好的两个人一个一个来呢？",
                "两个人一起上太不讲武德了吧！"
            ]
        },
        "42_0": {
            "lines": [
                "哎呀哎呀还是没有击败你呢。",
                "比试结果是我输了呢"
            ]
        },
        "50_0": {
            "lines": [
                "用消费能力衡量人的一切，",
                "现在看来确实有失偏颇。"
            ]
        },
        "58_0": {
            "lines": [
                "不过在你和其他人的打击下，",
                "这种妖气似乎要散尽了呢。"
            ]
        },
        "66_0": {
            "lines": [
                "利己主义者时刻想和别人划清界限。"
            ]
        },
        "74_0": {
            "lines": [
                "把一些商品的描述得不可僭越……",
                "现在可以解放掉柠檬水了吧？"
            ]
        },
        "82_0": {
            "lines": [
                "喂，东方明珠塔",
                "这样可以吗？"
            ]
        },
        "90_0": {
            "lines": [
                "反正我已经失去了防御塔的力量，",
                "就让外地人想怎么做就怎么做好了。"
            ]
        },
        "98_0": {
            "lines": [
                "拜和这个外乡人相遇所赐",
                "我已经失去战意了啊"
            ]
        },
        "106_0": {
            "lines": [
                "好的，好的。",
                "那么，就解放他们了！"
            ]
        },
        "114_0": {
            "lines": [
                "这样一来就不会有人因为",
                "不喝星巴克被打压了吧？"
            ]
        },
        "122_0": {
            "lines": [
                "真的不会了吗？"
            ]
        },
        "130_0": {
            "lines": [
                "一边打压不喝星巴克的人，",
                "一边把星巴克包装成不可僭越的东西。"
            ]
        },
        "138_0": {
            "lines": [
                "我可没有骗你哦。"
            ]
        },
        "146_0": {
            "lines": [
                "即使你们打翻了星巴克，",
                "他们还是能想出各种切割的方式。"
            ]
        },
        "154_0": {
            "lines": [
                "只是从结果上看，",
                "你们确实赢了。"
            ]
        },
        "162_0": {
            "lines": [
                "但是距离结束还远着呢。"
            ]
        },
        "170_0": {
            "lines": [
                "这样…就好吧。"
            ]
        },
        "178_0": {
            "lines": [
                "反正我不至于被自家人",
                "拒之门外不能进来了吧？"
            ]
        },
        "186_0": {
            "lines": [
                "显然如此。"
            ]
        },
        "194_0": {
            "lines": [
                "你们之前不就完成了吗？"
            ]
        },
        "202_0": {
            "lines": [
                "的确的啊，拔掉了入沪的签证",
                "就连本地人回来都需要，真是可恶！"
            ]
        },
        "210_0": {
            "lines": [
                "当然，结束了，这场闹剧。"
            ]
        },
        "218_0": {
            "lines": [
                "是时候回去了。"
            ]
        },
        "226_0": {
            "lines": [
                "防御塔的能量已经逸散掉了，",
                "好好做你的广播电视塔好了。"
            ]
        },
        "234_0": {
            "lines": [
                "当然这意味着所有的防御塔，",
                "都将要失去效能了呢。"
            ]
        },
        "242_0": {
            "lines": [
                "无所谓了，这防御塔就知道打我，",
                "防御塔一定要能防御！"
            ]
        },
        "250_0": {
            "lines": [
                "啊哈哈哈！",
                "真有趣！"
            ]
        },
        "258_0": {
            "lines": [
                "之后也不会有人来追击你了。"
            ]
        },
        "266_0": {
            "lines": [
                "或许不会再有下一次的闹剧了，",
                "是时候一起包饺子了。"
            ]
        },
        "274_0": {
            "lines": [
                "都是托你的福呢。"
            ]
        },
        "282_0": {
            "lines": [
                "归根到底还是白挣扎了一次，",
                "该回去改进星巴克了。"
            ]
        },
        "290_0": {
            "lines": [
                "某种意义上你也是乡毋宁。"
            ]
        },
        "298_0": {
            "lines": [
                "无所谓了，正常的魔都居民，",
                "没有几个会在乎这些的。"
            ]
        }
    }
}