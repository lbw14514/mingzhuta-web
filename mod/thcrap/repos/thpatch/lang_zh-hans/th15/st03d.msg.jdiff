{
    "0": {
        "34_0": {
            "lines": [
                "这就是中国的高铁吗？",
                "……好久没来都快忘了"
            ]
        },
        "102_0": {
            "lines": [
                "怎么还有这种人来这里的？"
            ]
        },
        "140_0": {
            "lines": [
                "那帮穿着戏服的就算了，",
                "穿着不是名牌衣服的也就那样了。"
            ]
        },
        "148_0": {
            "lines": [
                "你戴个老军帽是干嘛的？",
                "行为艺术吗？"
            ]
        },
        "156_0": {
            "lines": [
                "Блин!（真是的！）",
                "我好歹也是个露西亚人的吧？"
            ]
        },
        "164_0": {
            "lines": [
                "我去上海旅个游而已，",
                "我这种人去那里总没事吧？"
            ]
        },
        "172_0": {
            "lines": [
                "你在这里忽悠谁呢？",
                "你这头紫毛分明是杀马特嘛！"
            ]
        },
        "180_0": {
            "lines": [
                "你什么车，什么手机，什么学历？",
                "等着连麦的在后面排着队呢！"
            ]
        },
        "188_0": {
            "lines": [
                "没驾照，安卓机，深北莫留学，",
                "这下总没那么寒酸了吧？"
            ]
        },
        "196_0": {
            "lines": [
                "我长得有那么像杀马特吗？",
                "你脑袋长得跟个苹果一样的！"
            ]
        },
        "204_0": {
            "lines": [
                "深北莫？啥大学，听也没听说过，",
                "还是安卓机，你就一安卓人！"
            ]
        },
        "212_0": {
            "lines": [
                "就这种程度就想进入魔都境内吗？",
                "你自己好好掂量一下吧！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "我还没菜到那种程度呢。",
                "我一个来留学的至于没经济吗？"
            ]
        },
        "42_0": {
            "lines": [
                "你一看到我就像应激了一样的，",
                "你把我当成嘉豪了是吧？"
            ]
        },
        "50_0": {
            "lines": [
                "这样……"
            ]
        },
        "58_0": {
            "lines": [
                "既然如此那我也不演了，",
                "你如果想要闯过魔都的关口，"
            ]
        },
        "66_0": {
            "lines": [
                "或者说，拿到魔都的通关文牒，",
                "都已经不是那么容易的事情了。"
            ]
        },
        "74_0": {
            "lines": [
                "每个地方都有了属于自己的防御塔，",
                "就好像一股神秘的气息笼罩了这里。"
            ]
        },
        "82_0": {
            "lines": [
                "江浙沪我可都去过的，",
                "进都不让进，你闹呢？"
            ]
        },
        "90_0": {
            "lines": [
                "想打败我？我还有护盾呢。",
                "总还是能帮我抵抗激光的！"
            ]
        },
        "98_0": {
            "lines": [
                "不，魔都突然产生的那种狂气，",
                "未必是你能解决得了的！"
            ]
        },
        "106_0": {
            "lines": [
                "做不到成为像我一样的精英，",
                "说不定要被防御塔锁定的。"
            ]
        },
        "114_0": {
            "lines": [
                "至于我为什么会站在这里，",
                "那自然是回去取了点钱再回来。"
            ]
        },
        "122_0": {
            "lines": [
                "你的学历我认可了，",
                "但是我可不是没提醒过你。"
            ]
        },
        "130_0": {
            "lines": [
                "对于紫发的你，现今的魔都",
                "只能被视作是杀马特了吧"
            ]
        },
        "138_0": {
            "lines": [
                "请您万分小心",
                "以后不要做假发质感的染发了。"
            ]
        }
    }
}