{
    "2": {
        "184_0": {
            "lines": [
                "居然准备踏上返程之旅了吗？"
            ]
        },
        "308_0": {
            "lines": [
                "今天我以沪×风的名号，"
            ]
        },
        "432_0": {
            "lines": [
                "把你对精英生活方式的亵渎，",
                "全都发泄到你的身上吧！"
            ]
        }
    },
    "0": {
        "214_0": {
            "lines": [
                "为了在魔都喝上一杯柠檬水，",
                "你还真的是煞费苦心啊。"
            ]
        },
        "222_0": {
            "lines": [
                "愚蠢的外乡人都已经派人来搅局了，",
                "要是再这样下去就真的要失败了。"
            ]
        },
        "260_0": {
            "lines": [
                "好啊我就知道又是你！"
            ]
        },
        "268_0": {
            "lines": [
                "但是你现在可没法",
                "把我肘击掉了。"
            ]
        },
        "276_0": {
            "lines": [
                "我现在可是在远离上海的地方！"
            ]
        },
        "284_0": {
            "lines": [
                "没有了入沪签证的限制，"
            ]
        },
        "292_0": {
            "lines": [
                "这些外乡人居然已经能自由地进出这里了。",
                "在这片土地上开起了一家家廉价食品店。"
            ]
        },
        "300_0": {
            "lines": [
                "当然，在我的影响下还不会有人光顾他们。"
            ]
        },
        "308_0": {
            "lines": [
                "为了让这种精致感高级感不被扼杀，",
                "我特地从西洋请来一个神仙"
            ]
        },
        "316_0": {
            "lines": [
                "好了快出来吧！",
                "星巴克的女神，雷碧百事祖利啊！"
            ]
        },
        "428_0": {
            "lines": [
                "都已经连星巴克都喝不起了吗？",
                "这样可是不能进入魔都俱乐部的。"
            ]
        },
        "436_0": {
            "lines": [
                "不是你能不能想清楚？",
                "是我喝不起吗？？？"
            ]
        },
        "444_0": {
            "lines": [
                "当然，我可不仅仅代表着星巴克，",
                "我背后的任何牌子都是你的一辈子。"
            ]
        },
        "452_0": {
            "lines": [
                "在正式向外乡人复仇之前，",
                "先把眼前这个刺头先解决掉吧。"
            ]
        },
        "460_0": {
            "lines": [
                "这也是外乡人吗？",
                "有点像薯片只吃可某克的。"
            ]
        },
        "468_0": {
            "lines": [
                "哼……至于可乐，",
                "我承认我们还是太普适化了。"
            ]
        },
        "476_0": {
            "lines": [
                "你给我闪一边去，我顿顿吃百事薯片，",
                "现在我能不能堂堂正正进入你们魔都啦？"
            ]
        },
        "484_0": {
            "lines": [
                "没那么简单，星巴克的权威可不是我决定的，",
                "排斥你的分明是魔都妖异中的社会意识。"
            ]
        },
        "492_0": {
            "lines": [
                "局势开始紧张起来了呢。"
            ]
        },
        "500_0": {
            "lines": [
                "拜这人类所赐，我们的",
                "败北已经确定了大半了。"
            ]
        },
        "508_0": {
            "lines": [
                "哇哦，看着不太像有钱的，",
                "竟然这么恣意妄为的挑战吗？"
            ]
        },
        "516_0": {
            "lines": [
                "外乡人就是这么狡猾，竟将这种人类",
                "送进我们的计划中来。"
            ]
        },
        "524_0": {
            "lines": [
                "哼，真是有趣。既然东方明珠塔都",
                "这样说了，那看来是真人真事呢。"
            ]
        },
        "532_0": {
            "lines": [
                "嘛，虽然不是很明白",
                "但是本尊就在此！"
            ]
        },
        "540_0": {
            "lines": [
                "靠消费能力和什么品牌就把人拒之门外，",
                "在我这里可没那么容易！"
            ]
        },
        "548_0": {
            "lines": [
                "你们的努力，简直「球也拦不成」！",
                "（晋语张呼片方言：「啥也干不成」）"
            ]
        },
        "556_0": {
            "lines": [
                "想要靠方言来召唤你的防御塔吗？",
                "无论你的家乡是河北还是山西"
            ]
        },
        "564_0": {
            "lines": [
                "都是做不到的呢，",
                "就像你刚才说的那句话一样！"
            ]
        },
        "572_0": {
            "lines": [
                "挑战这精致生活区本就是徒劳的！"
            ]
        },
        "580_0": {
            "lines": [
                "居然还想百万撤离，",
                "实在是有些痴心妄想了。"
            ]
        },
        "588_0": {
            "lines": [
                "「对星巴克不可撼动的地位口出狂言」",
                "　这一个理由就完全能把你打入地狱"
            ]
        },
        "596_0": {
            "lines": [
                "就是这么一个简单的理由！",
                "我会让你一辈子都后悔的！"
            ]
        }
    },
    "1": {
        "34_0": {
            "lines": [
                "两个一起来最后也没用的！"
            ]
        },
        "42_0": {
            "lines": [
                "哎呀哎呀还是没有击败你呢。",
                "比试结果是我输了呢"
            ]
        },
        "50_0": {
            "lines": [
                "用消费能力衡量人的一切，",
                "现在看来确实有失偏颇。"
            ]
        },
        "58_0": {
            "lines": [
                "不过在你和其他人的打击下，",
                "这种妖气似乎要散尽了呢。"
            ]
        },
        "66_0": {
            "lines": [
                "利己主义者时刻想和别人划清界限呢。"
            ]
        },
        "74_0": {
            "lines": [
                "非要把普适的东西包装得至高无上，",
                "然后吸引一帮人搞身份认同真是愚蠢。"
            ]
        },
        "82_0": {
            "lines": [
                "现在是时候把外乡人解放了吧？"
            ]
        },
        "90_0": {
            "lines": [
                "喂，东方明珠塔",
                "这样可以吗？"
            ]
        },
        "98_0": {
            "lines": [
                "反正我已经失去了防御塔的力量，",
                "就让外地人想怎么做就怎么做好了。"
            ]
        },
        "106_0": {
            "lines": [
                "拜和这个外乡人相遇所赐",
                "我已经失去战意了啊"
            ]
        },
        "114_0": {
            "lines": [
                "OK——OK——",
                "那么，就解放他们吧"
            ]
        },
        "122_0": {
            "lines": [
                "这样一来就不会有人因为",
                "不喝星巴克被打压了吧？"
            ]
        },
        "130_0": {
            "lines": [
                "只是为了柠檬水就敌视人啊……"
            ]
        },
        "138_0": {
            "lines": [
                "这样的态度未免有些过分了，",
                "作为外地人我真的要肘击你了。"
            ]
        },
        "146_0": {
            "lines": [
                "显然没问题，但是也有不可改变的事实：",
                "精致主义者可都是狡猾又利己的呢。"
            ]
        },
        "154_0": {
            "lines": [
                "即使你们打翻了星巴克，",
                "他们还是能想出各种切割的方式。"
            ]
        },
        "162_0": {
            "lines": [
                "而且总会找到高人一等的方式。"
            ]
        },
        "170_0": {
            "lines": [
                "他们才是和普通人有着血海深仇啊。"
            ]
        },
        "178_0": {
            "lines": [
                "和没有伤害他们的人有血海深仇吗？",
                "多少脑子有点问题的呢……"
            ]
        },
        "186_0": {
            "lines": [
                "哎呀，现在进入沪总算不用签证了，",
                "来之前我连签证放在哪都不知道。"
            ]
        },
        "194_0": {
            "lines": [
                "不是所有人都是为了买苹果手机的。"
            ]
        },
        "202_0": {
            "lines": [
                "不过至少你们应该也不会在乎，在柠檬水",
                "进入这里之后，他们会落荒而逃的。"
            ]
        },
        "210_0": {
            "lines": [
                "现在要不得不回去坐好了，",
                "快要失去维持的力量了。"
            ]
        },
        "218_0": {
            "lines": [
                "一个塔就这么飞过来……"
            ]
        },
        "226_0": {
            "lines": [
                "喝一杯柠檬水被嘲讽穷酸，纯是来找茬的。"
            ]
        },
        "234_0": {
            "lines": [
                "当然，现在这个塔估计会安分下来，",
                "是时候和柠檬水产业共生共荣了。"
            ]
        },
        "242_0": {
            "lines": [
                "这也就说明防御塔的事情，",
                "同时也都会结束了呢。"
            ]
        },
        "250_0": {
            "lines": [
                "你也没法跟一个没有防御塔的地方说话，",
                "也不是没有，就是不会过来帮忙。"
            ]
        },
        "258_0": {
            "lines": [
                "那就去你们那里看看好了，",
                "就以百事可乐的身份过去。"
            ]
        },
        "266_0": {
            "lines": [
                "那很平民了……"
            ]
        }
    }
}